const PGID = { his: 'pgHis', home: 'pgHome', mis: 'pgMis', col: 'pgCol', mer: 'pgMer', prof: 'pgProf', aj: 'pgAj' }, PGS = ['mer', 'his', 'home', 'mis', 'prof', 'aj'];
