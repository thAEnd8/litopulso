let wheelRot = 0;
function prizeHTML(r) {
  if (r.item) { const c = r.item; return '<div class="prize r-' + c.r + ' pop"><div class="ptile">' + (c.k === 'col' ? '<i class="sw2" style="background:' + c.v + '"></i>' : c.k === 'emb' ? emblemSVG(c.v) : '<i class="fr ' + c.v + '"></i>') + '</div><div><b>' + (r.dupf ? 'Repetido' : '¡Nuevo!') + '</b><br>' + c.n + ' · ' + RN[c.r] + '<br><small>' + (r.dupf ? '+' + r.dupf + ' fragmentos' : r.gar ? 'Garantía de 5 giros' : 'Ya está en tu colección') + '</small></div></div>'; }
  if (r.mod) { const m = MODS[r.mod]; return '<div class="prize r-' + m.r + ' pop"><div class="big">⬢</div><div><b>' + (r.dupf ? 'Repetida' : '¡Pieza nueva!') + '</b><br>' + m.name + '<br><small>' + (r.dupf ? '+' + r.dupf + ' fragmentos' : 'Equípala en el Garaje') + '</small></div></div>'; }
  if (r.o === 'x') return '<div class="prize pop"><div class="big">+1</div><div><b>¡Giro extra!</b><br><small>Te devuelven el ticket</small></div></div>';
  return '<div class="prize pop"><div class="big">+' + (r.o === 'f3' ? 3 : 1) + ' ◆</div><div><b>Fragmentos</b><br><small>10 = un giro más</small></div></div>';
}
$('#spinBtn').addEventListener('click', () => {
  if (spinning || col.tk <= 0) return; spinning = true; pend = '';
  const r = spinOnce(); renderCol(); $('#colMsg').textContent = ''; $('#spinRes').innerHTML = '';
  const opts = SLA.filter(s => s.k === r.o), pickS = opts[Math.floor(Math.random() * opts.length)];
  const mid = pickS.mid + (Math.random() - .5) * (pickS.a1 - pickS.a0) * .7;
  const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches, dur = reduce ? 500 : 5400;
  wheelRot = Math.ceil(wheelRot / 360) * 360 + 360 * 7 - mid; const ww = document.querySelector('.wheelwrap'); ww.classList.add('spinning');
  const g = $('#wheelG'); g.style.transition = 'transform ' + dur + 'ms cubic-bezier(.1,.62,.06,1)'; g.style.transform = 'rotate(' + wheelRot + 'deg)';
  const nT = reduce ? 0 : 46; for (let k = 1; k <= nT; k++) setTimeout(() => AU.tap(), dur * (1 - Math.pow(1 - k / nT, 1 / 3)) * .98);
  setTimeout(() => {
    spinning = false; ww.classList.remove('spinning'); ww.style.setProperty('--wg', r.o === 'r' ? '#ff5a4a' : r.o === 'b' ? '#4fa3ff' : (r.nw || r.o === 'x') ? '#ffd34a' : '#1fb5a8'); $('#spinRes').innerHTML = prizeHTML(r); (r.nw || r.o === 'x') ? AU.win() : AU.ready();
    $('#wheelWrap') && 0; document.querySelector('.wheelwrap').classList.add('wglow'); setTimeout(() => document.querySelector('.wheelwrap').classList.remove('wglow'), 1300);
    renderCol();
  }, dur + 80);
});
