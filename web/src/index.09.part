const MGLY = { head: '◆', body: '■', legs: '▲', spec: '★' };

// ===== duelo en línea (PvP) =====
// Cada teléfono corre el mismo motor con la misma semilla; solo viajan las cartas elegidas.
// Los mensajes pasan por servidores MQTT públicos y gratuitos (dos a la vez, por si uno falla).
function mulberry(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

const NET = (() => {
  const enc = new TextEncoder(), dec = new TextDecoder();
  let qsb = null; try { qsb = new URLSearchParams(location.search).get('broker'); } catch (e) {}
  const URLS = qsb ? [qsb] : ['wss://broker.emqx.io:8084/mqtt', 'wss://broker.hivemq.com:8884/mqtt'];
  const me = Math.random().toString(36).slice(2, 10);
  let conns = [], subs = [], onMsg = null, onState = null, seen = new Set(), seq = 0;
  const str = s => { const b = enc.encode(s); return [b.length >> 8, b.length & 255, ...b]; };
  function pkt(type, body) {
    const len = []; let n = body.length;
    do { let d = n % 128; n = Math.floor(n / 128); if (n > 0) d |= 128; len.push(d); } while (n > 0);
    return new Uint8Array([type, ...len, ...body]);
  }
  const report = () => { onState && onState(conns.some(c => c.ok)); };
  function sub(c, t) { const id = (c.pid++ & 0xffff) || 1; c.ws.send(pkt(0x82, [id >> 8, id & 255, ...str(t), 0])); }
  function got(txt) {
    let m; try { m = JSON.parse(txt); } catch (e) { return; }
    if (!m || !m.k || seen.has(m.k)) return;
    seen.add(m.k); if (seen.size > 600) seen = new Set([...seen].slice(-300));
    onMsg && onMsg(m);
  }
  function parse(c) {
    for (;;) {
      const b = c.buf; if (b.length < 2) return;
      let mul = 1, len = 0, i = 1, d;
      do { if (i >= b.length) return; d = b[i++]; len += (d & 127) * mul; mul *= 128; } while (d & 128);
      if (b.length < i + len) return;
      const head = b[0], body = b.subarray(i, i + len);
      c.buf = b.slice(i + len);
      const type = head >> 4;
      if (type === 2) {
        if (body[1] === 0) {
          c.ok = true; subs.forEach(t => sub(c, t));
          clearInterval(c.ping); c.ping = setInterval(() => { try { c.ws.send(new Uint8Array([0xC0, 0])); } catch (e) {} }, 20000);
          report();
        }
      } else if (type === 3) {
        const tl = body[0] << 8 | body[1]; let off = 2 + tl; if ((head >> 1 & 3) > 0) off += 2;
        got(dec.decode(body.subarray(off)));
      }
    }
  }
  function open(url) {
    const c = { url, ws: null, ok: false, buf: new Uint8Array(0), ping: null, pid: 1, dead: false };
    const retry = () => { if (!c.dead) setTimeout(start, 2500); };
    function start() {
      if (c.dead) return;
      let ws; try { ws = new WebSocket(url, 'mqtt'); } catch (e) { retry(); return; }
      c.ws = ws; ws.binaryType = 'arraybuffer'; c.buf = new Uint8Array(0);
      ws.onopen = () => { try { ws.send(pkt(0x10, [...str('MQTT'), 4, 2, 0, 40, ...str('lp9' + me + Math.random().toString(36).slice(2, 7))])); } catch (e) {} };
      ws.onmessage = e => { const d = new Uint8Array(e.data), nb = new Uint8Array(c.buf.length + d.length); nb.set(c.buf); nb.set(d, c.buf.length); c.buf = nb; try { parse(c); } catch (x) {} };
      ws.onclose = () => { const was = c.ok; c.ok = false; clearInterval(c.ping); if (was) report(); retry(); };
      ws.onerror = () => { try { ws.close(); } catch (e) {} };
    }
    c.close = () => { c.dead = true; c.ok = false; clearInterval(c.ping); try { c.ws && c.ws.close(); } catch (e) {} };
    start();
    return c;
  }
  return {
    me,
    get up() { return conns.some(c => c.ok); },
    start(topics, msgCb, stateCb) { this.stop(); subs = topics; onMsg = msgCb; onState = stateCb; conns = URLS.map(open); },
    pub(topic, obj) {
      obj.k = me + ':' + (++seq);
      const p = pkt(0x30, [...str(topic), ...enc.encode(JSON.stringify(obj))]);
      conns.forEach(c => { if (c.ok) try { c.ws.send(p); } catch (e) {} });
    },
    stop() { conns.forEach(c => c.close()); conns = []; subs = []; onMsg = onState = null; }
  };
})();

const PVP_SECS = 40, ROOM_ABC = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
let PVP = { on: false, state: 'idle' };
let pvpRec = { w: 0, d: 0, l: 0 };
try { const r = JSON.parse(localStorage.getItem('duelo-pvp')); if (r && typeof r.w === 'number') pvpRec = r; } catch (e) {}
const pvpTopic = (code, role) => 'litopulso9/' + code + '/' + role;
const cleanName = s => String(s || 'Rival').replace(/[<>&"]/g, '').slice(0, 14) || 'Rival';

function pvpBuildOk(b) {
  if (!b || !ROBOTS[b.robot] || !Array.isArray(b.cards) || !Array.isArray(b.passives)) return false;
  if (b.cards.length < 3 || b.cards.length > 5 || new Set(b.cards).size !== b.cards.length || b.cards.some(id => !CARDS[id])) return false;
  if (b.passives.length !== CFG.passiveSlots || b.passives.some(id => !PASSIVES[id] || PASSIVES[id].robot !== b.robot)) return false;
  return true;
}
function pvpView(v) {
  $('#pvpMenu').hidden = v !== 'menu';
  $('#pvpWait').hidden = v !== 'wait';
  $('#pvpClose').textContent = v === 'menu' ? 'Cerrar' : 'Cancelar';
}
function pvpSay(t) { $('#pvpErr').textContent = t || ''; }
function pvpOpen() {
  AU.tap(); pvpSay('');
  $('#pvpRec').textContent = 'Tu récord en línea: ' + pvpRec.w + ' ganadas · ' + pvpRec.d + ' empates · ' + pvpRec.l + ' perdidas.';
  pvpView('menu'); $('#pvp').hidden = false;
}
function pvpSend(o) { if (PVP.code) NET.pub(pvpTopic(PVP.code, PVP.role), Object.assign({ r: PVP.round || 0 }, o)); }
function pvpReset() {
  clearInterval(PVP.tick); pvpClockStop();
  PVP = { on: false, state: 'idle', round: 0, picks: {}, acked: {}, mine: null, lastRx: Date.now(), lastPing: 0 };
}
function pvpStartNet() {
  PVP.myB = { robot: build.robot, cards: build.cards.slice(), passives: build.passives.slice() };
  PVP.lastRx = Date.now(); PVP.t0 = Date.now();
  NET.start([pvpTopic(PVP.code, PVP.role === 'h' ? 'g' : 'h')], pvpMsg, up => { PVP.netUp = up; pvpStatus(); });
  PVP.tick = setInterval(pvpTick, 1500);
  pvpStatus();
}
function pvpStatus() {
  if (PVP.state !== 'wait') return;
  const st = $('#pvpSt'), long = Date.now() - PVP.t0 > 12000;
  if (!NET.up) st.textContent = long ? 'No logro conectarme. Revisa que tengas internet.' : 'Conectando…';
  else if (PVP.role === 'h') st.textContent = 'Esperando a que tu rival escriba el código…';
  else st.textContent = long ? 'No encuentro la sala ' + PVP.code + '. Revisa el código o que tu rival siga en la sala.' : 'Buscando la sala…';
}
function pvpHost() {
  const bad = validBuild(build); if (bad) { pvpSay(bad + ' Arréglalo en el Garaje.'); return; }
  AU.tap(); pvpReset();
  let c = ''; for (let i = 0; i < 4; i++) c += ROOM_ABC[Math.floor(Math.random() * ROOM_ABC.length)];
  PVP.role = 'h'; PVP.code = c; PVP.state = 'wait';
  $('#pvpWaitT').textContent = 'Comparte este código con tu rival:';
  $('#pvpShow').textContent = c; pvpView('wait'); pvpSay('');
  pvpStartNet();
}
function pvpJoin() {
  const c = ($('#pvpCode').value || '').toUpperCase().replace(/[^A-Z]/g, '');
  if (c.length !== 4) { pvpSay('El código tiene 4 letras.'); return; }
  const bad = validBuild(build); if (bad) { pvpSay(bad + ' Arréglalo en el Garaje.'); return; }
  AU.tap(); pvpReset();
  PVP.role = 'g'; PVP.code = c; PVP.state = 'wait';
  $('#pvpWaitT').textContent = 'Uniéndote a la sala';
  $('#pvpShow').textContent = c; pvpView('wait'); pvpSay('');
  pvpStartNet();
}
function pvpCancel() {
  const was = PVP.code, topic = was ? pvpTopic(PVP.code, PVP.role) : null, r = PVP.round || 0;
  if (was) { NET.pub(topic, { t: 'bye', r }); setTimeout(() => NET.pub(topic, { t: 'bye', r }), 250); }
  pvpReset(); $('#pvp').hidden = true;
  if (was) setTimeout(() => { if (!PVP.code) NET.stop(); }, 700);
}
function pvpLeave() { if (PVP.code) pvpCancel(); }

function pvpNewRound() {
  PVP.round = (PVP.round || 0) + 1;
  PVP.seed = Math.floor(Math.random() * 4294967296) >>> 0;
  PVP.arena = selArena;
  PVP.okRound = 0;
  pvpSend({ t: 'start', to: PVP.sid, seed: PVP.seed, arena: PVP.arena, name: pname, b: PVP.myB });
  pvpBegin();
}
function pvpBegin() {
  PVP.state = 'play'; PVP.on = true; PVP.picks = {}; PVP.acked = {}; PVP.mine = null;
  PVP.againMe = PVP.againOpp = false; PVP.gone = false; PVP.note = ''; PVP.ended = false; PVP.void = false;
  PVP.lastRx = Date.now();
  $('#pvp').hidden = true; $('#end').hidden = true;
  startDuel();
}
function pvpMsg(m) {
  PVP.lastRx = Date.now();
  if (m.t === 'ping') return;
  if (m.t === 'bye') { pvpOppGone('Tu rival salió del duelo.'); return; }
  if (PVP.role === 'h') {
    if (m.t === 'hello') {
      if (PVP.sid && PVP.sid !== m.sid) return;
      if (!pvpBuildOk(m.b)) { pvpSay('El equipo de tu rival no es válido.'); return; }
      if (!PVP.sid) { PVP.sid = m.sid; PVP.opp = { name: cleanName(m.name), b: m.b }; pvpNewRound(); }
      else if (PVP.okRound !== PVP.round) pvpSend({ t: 'start', to: PVP.sid, seed: PVP.seed, arena: PVP.arena, name: pname, b: PVP.myB });
      return;
    }
    if (m.t === 'ok' && m.r === PVP.round) { PVP.okRound = m.r; return; }
  } else {
    if (m.t === 'start' && m.to === NET.me && m.r > (PVP.round || 0)) {
      if (!pvpBuildOk(m.b)) { pvpSay('El equipo de tu rival no es válido.'); return; }
      PVP.round = m.r; PVP.seed = m.seed >>> 0; PVP.arena = Math.min(5, Math.max(1, m.arena | 0)); PVP.opp = { name: cleanName(m.name), b: m.b };
      pvpSend({ t: 'ok' });
      pvpBegin();
      return;
    }
    if (m.t === 'start' && m.to === NET.me && m.r === PVP.round) { pvpSend({ t: 'ok' }); return; }
  }
  if (m.r !== PVP.round) return;
  if (m.t === 'pick') {
    pvpSend({ t: 'ack', turn: m.turn });
    if (!PVP.picks[m.turn]) {
      PVP.picks[m.turn] = m;
      if (G && !G.over && m.turn === G.turn && (!PVP.mine || PVP.mine.turn !== G.turn)) { setSlot($('#slotFoe'), 'back ready', '✓'); $('#msg').textContent = 'Tu rival ya eligió.'; }
      PVP.waiter && PVP.waiter();
    }
  } else if (m.t === 'ack') {
    PVP.acked[m.turn] = true;
  } else if (m.t === 'again') {
    PVP.againOpp = true;
    if (!$('#end').hidden && !PVP.againMe) $('#xpText').textContent = 'Tu rival quiere la revancha.';
    if (PVP.againMe && PVP.role === 'h') pvpNewRound();
  }
}
