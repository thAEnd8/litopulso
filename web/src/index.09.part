const NAVS = ['bar', 'fan', 'side', 'fab'], NM = ' Jugar va en el centro; a los lados están Garaje, Mercado, Ruleta, Misiones, Perfil (con tu colección) y Ajustes.';
const NAVTXT = { bar: 'Este es tu menú.' + NM + ' También puedes deslizar de lado.', fan: 'Este es tu núcleo: tócalo para abrir el menú.' + NM + ' También puedes deslizar de lado.', side: 'Este botón abre el menú.' + NM + ' También puedes deslizar de lado.', fab: 'Este botón abre el menú.' + NM + ' También puedes deslizar de lado.' };
function setNav(m, save) {
  if (NAVS.indexOf(m) < 0) m = 'bar';
  closeFan(); document.documentElement.dataset.nav = m; $('#hexnav').dataset.nav = m;
  $$('#navOpts [data-nav]').forEach(b => b.setAttribute('aria-checked', String(b.dataset.nav === m)));
  if (save) { try { localStorage.setItem('duelo-nav', m); } catch (e) {} }
}
$('#navOpts').addEventListener('click', e => { const b = e.target.closest('[data-nav]'); if (!b) return; AU.tap(); setNav(b.dataset.nav, true); });
