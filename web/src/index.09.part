  prof: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-5 5-7 8-7s7 2 8 7"/>', aj: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>'
};
const FAN = [['garage', 'Garaje'], ['mer', 'Mercado'], ['his', 'Historia'], ['home', 'Jugar'], ['mis', 'Misiones'], ['prof', 'Perfil'], ['aj', 'Ajustes']];
function pagerEl() { return document.getElementById('pager'); }
function updateNav() {
  document.querySelectorAll('.hx').forEach(h => h.classList.toggle('cur', h.dataset.go === curPage));
  document.querySelectorAll('.hexdots i').forEach((d, i) => d.classList.toggle('cur', PGS[i] === curPage));
}
function onPage(n) {
  if (n === curPage) return; curPage = n; updateNav(); AU.nav();
  if (n === 'home') renderHome(); else if (n === 'his') renderHis(); else if (n === 'mis') renderMis(); else if (n === 'col') renderCol(); else if (n === 'mer') { renderMer(); renderCol(); } else if (n === 'prof') { renderProfile(); renderCol(); }
}
function goPage(n, instant) {
  if (n === 'col') n = 'mer';
  if (curView !== 'home') show('home');
  closeFan(); const p = pagerEl(), el = document.getElementById(PGID[n]); if (!p || !el) return;
  p.scrollTo({ left: el.offsetLeft, behavior: instant ? 'auto' : 'smooth' }); onPage(n);
}
{ const _op = onPage; onPage = function (n) { _op(n); if (n === 'his') setTimeout(() => { if (curView === 'home') runTut(TUT_HIST, 'hist'); }, 500); }; }
(function build() {
  const nav = document.createElement('nav'); nav.className = 'hexnav'; nav.id = 'hexnav'; nav.setAttribute('aria-label', 'Menú');
  nav.innerHTML = '<div class="hexshade" id="hexshade"></div>' +
    FAN.map(([k, n]) => '<button class="hx' + (k === 'home' ? ' main' : '') + '" data-go="' + k + '" aria-label="' + n + '"><span class="hxin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + NI[k] + '</svg>' + (k === 'col' ? '<i class="bdg" id="tkBadge" hidden></i>' : '') + '</span><em>' + n + '</em></button>').join('') +
    '<div class="hexdots" aria-hidden="true">' + PGS.map(() => '<i></i>').join('') + '</div>' +
    '<button class="nucleo" id="nucleoBtn" aria-label="Abrir menú" aria-expanded="false"><span class="ni"></span><b></b></button>';
  document.getElementById('homeView').appendChild(nav);
})();
function openFan() {
  const nav = $('#hexnav'); nav.classList.add('open'); $('#nucleoBtn').setAttribute('aria-expanded', 'true');
  const hs = nav.querySelectorAll('.hx'), r = 140;
  hs.forEach((h, i) => { const hi = FAN.findIndex(x => x[0] === 'home'), a = (90 + (hi - i) * 25) * Math.PI / 180; h.style.setProperty('--x', (r * Math.cos(a)).toFixed(0) + 'px'); h.style.setProperty('--y', (-r * Math.sin(a) - 6).toFixed(0) + 'px'); h.style.transitionDelay = (i * 30) + 'ms'; });
}
function closeFan() { const nav = $('#hexnav'); if (!nav) return; nav.classList.remove('open'); $('#nucleoBtn').setAttribute('aria-expanded', 'false'); }
$('#nucleoBtn').addEventListener('click', () => { AU.tap(); $('#hexnav').classList.contains('open') ? closeFan() : openFan(); });
$('#hexshade').addEventListener('click', closeFan);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFan(); });
$('#hexnav').addEventListener('click', e => {
  const h = e.target.closest('.hx'); if (!h) return; AU.tap(); const k = h.dataset.go;
  if (k === 'garage') { closeFan(); openGarage(); } else if (k === 'rules') { closeFan(); $('#rules').hidden = false; $('#closeRules').focus(); } else goPage(k);
});
let scrT = 0;
pagerEl().addEventListener('scroll', () => { clearTimeout(scrT); scrT = setTimeout(() => { const p = pagerEl(), i = Math.round(p.scrollLeft / Math.max(1, p.clientWidth)); if (PGS[i]) onPage(PGS[i]); }, 90); }, { passive: true });
const _show = show;
show = function (v) { _show(v); if (v === 'home') { curPage = 'home'; const p = pagerEl(), hp = document.getElementById('pgHome'); if (p && hp) p.scrollLeft = hp.offsetLeft; closeFan(); updateNav(); } };
function refreshNucleo() { try { $('#hexnav').style.setProperty('--nc', coreColor(build.robot, levelOf(xp).level)); } catch (e) {} }
const _rh = renderHome; renderHome = function () { _rh(); refreshNucleo(); };
