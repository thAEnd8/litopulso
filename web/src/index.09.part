const STORY = [
  { t: 'Después de la explosión', p: ['Nadie sabe del todo qué se halló en la instalación. Lo que todos saben es lo que vino después: una explosión de energía tan grande que alcanzó a toda la humanidad. El lugar quedó marcado con un nombre: HEXX.', 'Las personas siguieron siendo en gran parte humanas, pero algo cambió dentro de ellas. En algún lugar del cuerpo les creció un núcleo de cristal.'] },
  { t: 'El núcleo y la pulsera', p: ['Cada núcleo nace con un mineral que nunca cambia. Con el tiempo solo cambia de color, del más claro al más oscuro, a medida que su dueño entrena y gana experiencia. Con él se pueden convertir partes del cuerpo en piedra o cristal y manipular energía.', 'Un año después llegaron las pulseras. La pulsera extrae la energía del núcleo y es tu menú; el canalizador, un pequeño robot, la recibe para desplegarse y combatir.'] },
  { t: 'La grieta del Hexx', p: ['Los enfrentamientos empezaron como peleas de energía pura y después se volvieron competencias con reglas. Tener más energía no es dominarla mejor: gana quien anticipa al rival, no quien tiene más.', 'Tú venciste al guardián de la grieta. El HEXX sigue vigilado y lo que hay en su origen sigue sin respuesta, pero tu núcleo ya no brilla igual que antes.'] }
];
let stI = 0;
function renderStory() {
  const end = stI >= STORY.length;
  $('#storyBody').innerHTML = end
    ? '<small>Fin del capítulo 1</small><h3>¿Qué quieres hacer?</h3><button class="btn" id="stPlay">Volver a jugar</button><button class="btn ghost" id="stAgain">Volver a leer la historia</button>'
    : '<small>Parte ' + (stI + 1) + ' de ' + STORY.length + '</small><h3>' + STORY[stI].t + '</h3>' + STORY[stI].p.map(x => '<p>' + x + '</p>').join('');
  $('#storyNav').hidden = end; $('#stPrev').style.visibility = stI === 0 ? 'hidden' : 'visible';
  $('#stNext').textContent = stI === STORY.length - 1 ? 'Terminar' : 'Siguiente';
}
function openStory() { stI = 0; renderStory(); $('#storyV').hidden = false; }
function closeStory() { $('#storyV').hidden = true; }
document.addEventListener('click', e => {
  const t = e.target.closest('button'); if (!t) return;
  if (t.id === 'storyBtn') { AU.tap(); openStory(); }
  else if (t.id === 'stClose') { AU.tap(); closeStory(); }
  else if (t.id === 'stNext') { AU.tap(); stI++; renderStory(); }
  else if (t.id === 'stPrev') { AU.tap(); stI = Math.max(0, stI - 1); renderStory(); }
  else if (t.id === 'stAgain') { AU.tap(); stI = 0; renderStory(); }
  else if (t.id === 'stPlay') { AU.tap(); closeStory(); goPage('home'); }
});

