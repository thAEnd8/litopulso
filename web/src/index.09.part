// ---- misiones (barras) ----
function misCard(cls, name, val, max, txt, extra, marks) {
  const p = Math.min(100, Math.round(val / max * 100)), done = val >= max;
  const IC = { '': '◆', gold: '★', silver: '✦' }, RW = { '': '+1 ticket', gold: 'Cosmético dorado', silver: 'Cosmético plateado' };
  const rw = /Difícil/.test(name) ? '+1 ticket' : RW[cls], ic = /Difícil/.test(name) ? '▲' : IC[cls];
  return '<div class="mis ' + cls + (done ? ' done' : '') + '"><div class="mhx">' + ic + '</div><div class="mbd"><div class="mhd"><b>' + name + '</b>' + (done ? '<span class="lista">★ LISTA</span>' : '') + '</div><small>' + extra + '</small><div class="mtrack"><i style="width:' + p + '%"></i>' + (marks || '') + '</div><div class="mrw"><span>' + txt + '</span><em>' + rw + '</em></div></div></div>';
}
function renderMis() {
  checkAuto(); saveCol();
  const t = col.md === today(), mn = t ? col.mn : 0, st = starsOf(xp), sv = Math.min(6, st + starProg(xp) / 100);
  const mk = [2, 4, 6].map(n => '<u class="' + (st >= n ? 'ok' : '') + '" style="left:' + (n / 6 * 100) + '%">' + n + '</u>').join('');
  const g = (id, name, v, m, hint) => misCard('gold', name, v, m, Math.min(v, m) + '/' + m, col.own[id] ? '<span class="got">Cosmético dorado conseguido</span>' : hint);
  $('#misTop').innerHTML = '<div class="rs"><b>' + mn + '</b><small>Duelos hoy</small></div><div class="rs"><b>' + col.tk + '</b><small>Tickets</small></div><div class="rs"><b>' + col.hp + '/' + HARD_PTS + '</b><small>Puntos para ticket</small></div>';
  $('#misList').innerHTML =
    misCard('', 'Misión diaria', mn, NORM_NEED, Math.min(mn, NORM_NEED) + '/' + NORM_NEED, 'Juega ' + NORM_NEED + ' duelos en Normal hoy. Premio: 1 ticket para la ruleta. Se reinicia cada día.') +
    misCard('', 'Gana tickets en Difícil', col.hp, HARD_PTS, col.hp + '/' + HARD_PTS, 'Cada duelo en Difícil da puntos: ganar 3, empatar 2, perder 1. Con ' + HARD_PTS + ' puntos ganas 1 ticket.') +
    g('au_petreo', 'Pétreo dorado', col.w.petreo, 25, 'Gana 25 duelos en Difícil con Pétreo.') +
    g('au_granito', 'Granito dorado', col.w.granito, 15, 'Gana 15 duelos en Difícil con Granito.') +
    g('au_cuarzo', 'Cuarzo dorado', col.cq, 10, 'Gana 10 duelos en Difícil con Cuarzo terminando con menos de 20 de vida.') +
    misCard('silver', 'Plateados por estrellas', sv, 6, st + ' ★', 'Un cosmético plateado cada 2 estrellas (2, 4 y 6). Cada estrella son 100 XP después del nivel 10.', mk);
}
