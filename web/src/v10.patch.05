{
  let intro = false, guided = false;
  try { intro = localStorage.getItem('lito-intro') === '1'; guided = localStorage.getItem('lito-guided') === '1'; } catch (e) {}
  setTimeout(() => { if (!intro) introStart(); else if (!guided) guideStart(); else tipFor('home'); }, 60);
}
