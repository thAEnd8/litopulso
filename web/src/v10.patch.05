function guideEnd() {
  const won = G.result === 'win';
  guideStop(); guideDone();
  $('#endT').textContent = won ? '¡Primer duelo ganado!' : 'Duelo terminado'; $('#endT').className = 'end-title ' + G.result;
  $('#endS').innerHTML = '<div><b>' + G.turn + '</b><small>turnos</small></div><div><b>' + G.dealt + '</b><small>daño hecho</small></div><div><b>' + G.taken + '</b><small>daño recibido</small></div>';
  endBadge(G.result); if (won) AU.win();
  $('.xpbox .xpbar').hidden = true; $('#xpText').textContent = 'Tu pulsera ya funciona. Ahora te enseño dónde está cada cosa.';
  $('#endUp').hidden = true; $('#endGarage').hidden = true;
  $('#again').hidden = true; $('#endHome').textContent = 'Continuar';
  $('#end').hidden = false;
  GUIDE.post = true;
}
function guidePost() {
  $('#again').hidden = false;
  runTut([
    { t: 'Aquí, en el Hexx, buscas rivales en línea. Ganar te da Pulso para avanzar hacia el centro.', sel: '#tabbar [data-go=home]', pos: 'top' },
    { t: 'Y aquí, en el Garaje, armas tu equipo: robot, cartas y pasivas. ¡Suerte!', sel: '#tabbar [data-go=gar]', pos: 'top' }
  ], 'post');
}
TUT_KEYS.post = 'lito-tut-post';
$('#endHome').addEventListener('click', () => { if (GUIDE.post) { GUIDE.post = false; try { localStorage.removeItem('lito-tut-post'); } catch (e) {} goPage('home', true); setTimeout(guidePost, 450); } });

// ---- minicómic de bienvenida ----
var INTRO = { on: false };
function introHTML() {
