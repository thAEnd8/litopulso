// ---- elementos en el garaje ----
let gElSel = '';
function renderEl() {
  if (!draft || !col || !col.inv) return;
  draft.el = draft.el || {};
  const cr = col.inv.cr || {}, used = Object.keys(draft.el).filter(id => draft.cards.includes(id)).length;
  $('#eCount').textContent = used + '/' + EL_MAX; $('#eCount').classList.toggle('ok', used > 0);
  $('#gElPick').innerHTML = ELEM_IDS.map(e => { const own = cr[e] > 0, on = gElSel === e; return '<button class="elc' + (on ? ' on' : '') + (own ? '' : ' lk') + '" data-el="' + e + '" style="--ec:' + ELEMS[e].c + '" aria-pressed="' + on + '"' + (own ? '' : ' aria-label="' + ELEMS[e].n + ' (bloqueado)"') + '>' + eIco(e) + '<b>' + ELEMS[e].n + '</b></button>'; }).join('');
  $('#gElCards').innerHTML = draft.cards.map(id => { const c = CARDS[id], e = draft.el[id]; return '<button class="elcard' + (e ? ' has' : '') + '" data-elcard="' + id + '"' + (e ? ' style="--ec:' + ELEMS[e].c + '"' : '') + '>' + (e ? eIco(e, 'onc') : '') + cardFace(c) + '<small>' + (e ? ELEMS[e].n : 'Sin elemento') + '</small></button>'; }).join('');
  $('#gElTxt').innerHTML = gElSel ? '<b>' + ELEMS[gElSel].n + ':</b> ' + ELEMS[gElSel].t + ' Toca una de tus cartas para ponérselo.' : 'Elige un cristal y luego toca la carta donde lo quieres. Toca una carta con elemento para quitárselo. Los cristales salen en los remanentes.';
}
$('#gElPick').addEventListener('click', e => {
  const b = e.target.closest('[data-el]'); if (!b) return; AU.tap(); const el = b.dataset.el;
  if (!((col.inv.cr || {})[el] > 0)) { $('#gElTxt').innerHTML = '<b>' + ELEMS[el].n + ':</b> ' + ELEMS[el].t + ' Aún no tienes este cristal: sale en los remanentes del Hexx.'; return; }
  gElSel = gElSel === el ? '' : el; renderEl();
});
$('#gElCards').addEventListener('click', e => {
  const b = e.target.closest('[data-elcard]'); if (!b) return; AU.tap(); const id = b.dataset.elcard;
  draft.el = draft.el || {};
  if (draft.el[id] && (!gElSel || draft.el[id] === gElSel)) delete draft.el[id];
  else if (gElSel) {
    const n = Object.keys(draft.el).filter(k => draft.cards.includes(k) && k !== id).length;
    if (n >= EL_MAX) { $('#gElTxt').textContent = 'Máximo ' + EL_MAX + ' cartas con elemento. Quita uno primero.'; return; }
    draft.el[id] = gElSel;
  } else return;
  garageChanged();
});
function crGrant() {
  col.inv.cr = col.inv.cr || {};
  const miss = ELEM_IDS.filter(e => !(col.inv.cr[e] > 0));
  if (!miss.length) { col.inv.chat += 4; return ['ch', 'Cristal repetido: +4 de chatarra']; }
  const e = miss[Math.floor(Math.random() * miss.length)]; col.inv.cr[e] = 1;
  return ['cr', 'Cristal de ' + ELEMS[e].n.toLowerCase() + ': ponlo en una carta en el Garaje'];
