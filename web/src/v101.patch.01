/* v10.1: elementos y combos */
.eb { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: color-mix(in srgb, var(--ec) 22%, #0e1319); box-shadow: 0 0 0 1.5px var(--ec); font-style: normal; flex: none; }
.eb svg { width: 12px; height: 12px; fill: none; stroke: var(--ec); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.eb.onc { position: absolute; top: 4px; right: 4px; z-index: 2; }
.card.hasel, .hs .eb.onc + .cico { box-shadow: inset 0 0 0 1.5px var(--ec), 0 0 12px color-mix(in srgb, var(--ec) 35%, transparent); }
.hs { position: relative; }
.card.cmb { animation: cmbGlow 1.2s ease-in-out infinite; }
@keyframes cmbGlow { 50% { box-shadow: 0 0 0 2px #ffd34a, 0 0 18px #ffd34a88; } }
.card .cbt { position: absolute; left: 50%; bottom: -9px; transform: translateX(-50%); white-space: nowrap; padding: 1px 6px; border-radius: 6px; background: #ffd34a; color: #2c1c00; font: 700 9.5px var(--font-display); font-style: normal; letter-spacing: .04em; z-index: 2; }
.sts { display: flex; flex-wrap: wrap; gap: 4px; min-height: 0; margin-top: 2px; }
.sts:empty { display: none; }
.sts .st { display: inline-flex; align-items: center; gap: 3px; padding: 1px 6px 1px 2px; border-radius: 9px; background: #ffffff10; font: 700 11px var(--font-display); }
.sts .st .eb { width: 16px; height: 16px; }
.sts .cmbt { padding: 0 4px; color: #ffd34a; font: 700 10.5px var(--font-display); letter-spacing: .04em; }
.float.el { color: #fff; font: 800 15px var(--font-display); text-shadow: 0 0 8px #000, 0 0 12px #ffffff66; }
.float.cmb { color: #ffd34a; font: 800 17px var(--font-display); text-shadow: 0 0 10px #ffd34a88, 0 2px 0 #000; }
.elpick { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin-bottom: 10px; }
.elc { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 2px; border: 1px solid var(--line); border-radius: 4px 12px 4px 12px; background: var(--panel); color: var(--fg); cursor: pointer; }
.elc b { font: 700 10.5px var(--font-display); }
.elc .eb { width: 26px; height: 26px; } .elc .eb svg { width: 16px; height: 16px; }
.elc.on { border-color: var(--ec); background: color-mix(in srgb, var(--ec) 16%, var(--panel)); box-shadow: 0 0 12px color-mix(in srgb, var(--ec) 40%, transparent); }
.elc.lk { opacity: .35; }
.elcards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
.elcard { position: relative; min-height: 84px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; padding: 14px 2px 6px; border: 1px solid var(--line); border-radius: 4px 12px 4px 12px; background: var(--panel-2); color: var(--fg); cursor: pointer; }
.elcard .cico { width: 24px; height: 26px; } .elcard b { font-size: 10px; }
.elcard small { font-size: 9.5px; color: var(--muted); }
.elcard.has { border-color: var(--ec); box-shadow: 0 0 10px color-mix(in srgb, var(--ec) 30%, transparent); }
.elcard.has small { color: var(--ec); font-weight: 700; }
#gElTxt { margin: 10px 0 0; font-size: 13px; line-height: 1.4; }
.emi.elx { display: inline-flex; align-items: center; gap: 5px; --rc: var(--ec); }
