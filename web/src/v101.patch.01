function drawStatus() {
  for (const sd of ['you', 'foe']) {
    const f = G[sd], el = $('#' + sd + '-sts'); if (!el) continue; const t = [];
    if (f.burn > 0) t.push(eIco('fuego') + '<b>' + f.burn + '</b>');
    if (f.chill > 0) t.push(eIco('hielo') + '<b>' + f.chill + '</b>');
    if (f.pzt > 0) t.push(eIco('veneno') + '<b>×' + f.pzn + '</b>');
    if (f.armor > 0) t.push(eIco('acero') + '<b>' + f.armor + '</b>');
    if (f.cmb && !G.over) t.push('<span class="cmbt">' + COMBOS[f.cmb].n + '</span>');
    el.innerHTML = t.map(x => '<span class="st">' + x + '</span>').join('');
  }
  const cm = G.you.cmb;
  $$('#hand .card').forEach(c => { const on = !G.over && comboFor(cm, c.dataset.t); c.classList.toggle('cmb', !!on); const e = c.querySelector('.cbt'); if (e) { e.hidden = !on; e.textContent = on ? COMBOS[cm].n + (COMBO_DMG[cm] ? ' +' + COMBO_DMG[cm] : ' +2⚡') : ''; } });
