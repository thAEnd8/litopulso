// elementos: un cristal en una carta; se activa cuando esa carta golpea o acierta
const ELEMS = {
  fuego:   { n: 'Fuego',   c: '#ff7a3a', t: 'Quema: el rival pierde 4 de vida al final de los 2 turnos siguientes.' },
  hielo:   { n: 'Hielo',   c: '#8fe0f0', t: 'Congela: el rival recupera 1 de energía menos durante 2 turnos.' },
  veneno:  { n: 'Veneno',  c: '#8ee26b', t: 'Envenena: 2 de daño por turno durante 3 turnos. Se acumula hasta 3 veces.' },
  energia: { n: 'Energía', c: '#ffd34a', t: 'Tu racha sube 1 extra: llegas antes a la Sobrecarga.' },
  acero:   { n: 'Acero',   c: '#b4bdca', t: 'Coraza: el siguiente golpe que recibas hace 6 menos.' }
};
const ELEM_IDS = Object.keys(ELEMS), EL_MAX = 2;
// combos: lo que hiciste bien el turno pasado prepara tu siguiente jugada
const COMBOS = {
  cnt: { n: 'Contraataque', t: 'Tu Defensa frenó: tu siguiente Ataque hace +8.' },
  fin: { n: 'Finta', t: 'Tu Desvío esquivó: tu siguiente Habilidad hace +8.' },
  raf: { n: 'Ráfaga', t: 'Tu Ataque golpeó: tu siguiente Ataque hace +4.' },
  rec: { n: 'Recarga', t: 'Tu Habilidad golpeó: si tu siguiente Defensa o Desvío acierta, +2 de energía.' }
};
const COMBO_DMG = { cnt: 8, fin: 8, raf: 4 };
const comboFor = (cmb, type) => cmb && ((cmb === 'cnt' || cmb === 'raf') && type === 'attack' || cmb === 'fin' && type === 'skill' || cmb === 'rec' && (type === 'guard' || type === 'dodge'));
