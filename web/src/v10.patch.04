    const now = m.costHp ? modCH(f, id) + ' de vida' : modCE(f, id) + ' de energía';
    const nxt = max ? '' : (m.costHp ? Math.round(m.costHp * [1, .75, .5][lv]) + ' de vida' : Math.max(0, m.costEn - lv) + ' de energía');
    return '<div class="upr"><div><b>' + m.name + ' · Nv ' + lv + '</b><small>Cuesta ' + now + (max ? ' · nivel máximo' : ' → ' + nxt) + '</small></div>' + (max ? '' : '<button class="chipbtn" data-up="' + id + '"' + (col.inv.chat < cost ? ' disabled' : '') + '>' + cost + ' chatarra</button>') + '</div>';
  }).join('') : '<p class="sub">Aún no tienes módulos. Salen en la ruleta y en los remanentes.</p>');
}
$('#gUp').addEventListener('click', e => {
  const b = e.target.closest('[data-up]'); if (!b) return;
  const id = b.dataset.up, lv = col.mlv[id] || 1, cost = UPC[lv]; if (lv >= 3 || col.inv.chat < cost) return;
  col.inv.chat -= cost; col.mlv[id] = lv + 1; saveCol(); AU.ready(); buzz(30); renderGarage();
});

// ---- inventario en el perfil ----
function renderInv() {
  const el = $('#profInv'); if (!el || !col || !col.inv) return;
  const iv = col.inv, nre = REACTS.filter(r => iv.re[r[0]]).length;
  const cell = (ic, n, t) => '<div class="iv"><svg viewBox="0 0 24 24" aria-hidden="true">' + RICO[ic] + '</svg><b>' + n + '</b><small>' + t + '</small></div>';
  el.innerHTML = '<div class="ivg">' + cell('es', iv.est, 'Estabilizadores') + cell('xp', iv.xpb, 'Duelos con XP ×2') + cell('ch', iv.chat, 'Chatarra') + cell('re', nre + '/' + REACTS.length, 'Reacciones') + '</div>' +
    '<div class="rel">' + REACTS.map(r => '<span class="emi r-' + r[2] + (iv.re[r[0]] ? '' : ' lk') + '">' + (iv.re[r[0]] ? r[1] : '???') + '</span>').join('') + '</div>' +
    '<p class="sub">El Estabilizador se usa solo cuando pierdes en el Hexx. La chatarra mejora tus módulos en el Garaje.</p>';
}

// ---- duelo guiado (tutorial jugando) ----
var GUIDE = { on: false, i: 0 };
const GUIDE_YOU = () => ({ robot: 'petreo', cards: ['atk', 'guard', 'dodge', 'skill'], passives: ['core', 'reflex'], mods: [] });
const GUIDE_FOE = () => ({ robot: 'granito', cards: ['atk', 'guard', 'dodge', 'skill'], passives: passivesOf('granito').slice(0, CFG.passiveSlots), mods: [] });
const GUIDE_STEPS = [
  { you: 'atk', foe: 'dodge', say: 'Cada turno, tú y tu rival eligen una carta en secreto y se revelan al mismo tiempo. Empieza con Martillo.' },
  { you: 'guard', foe: 'atk', say: 'Ataque gana a Desvío: le pegaste. Ahora tu pulsera detecta que el rival va a atacar: usa Muro.' },
  { you: 'skill', foe: 'guard', say: 'Defensa frena el Ataque y te da energía extra. Ahora se va a cubrir: Fractura rompe la Defensa. Cuesta 6 de energía (el número de la carta).' },
  { you: 'dodge', foe: 'skill', say: 'Habilidad rompe la Defensa. Viene una Habilidad del rival: esquívala con Giro.' },
  { you: 'atk', foe: 'dodge', say: 'Desvío evita la Habilidad. Cada acierto sube tu racha (abajo, junto a tu energía). Remata con Martillo.' },
  { you: 'over', foe: 'atk', say: '¡Racha 5! Tu Sobrecarga está lista: tócala para quitar 60 de un golpe.' }
];
function guideStart() {
  if (PVP.code) return;
  tutEnd(); HXBOT = false;
  GUIDE = { on: true, i: 0 };
  startDuel();
}
function guideSetup(g) {
  g.foe.maxHp = 150; g.foe.hp = 150; g.foe.edge = 0;
  g.you.maxHp = Math.max(g.you.maxHp, 150); g.you.hp = g.you.maxHp;
}
function guideCur() { return GUIDE_STEPS[Math.min(GUIDE_STEPS.length - 1, (G ? G.turn : 1) - 1)]; }
function guideOk(card) { const st = guideCur(); return st && (card.id === st.you || (st.you === 'over' && card.type === 'over')); }
function guideEl(st) { if (st.you === 'over') return $('#overBtn'); const i = G.you.hand.findIndex(c => c.id === st.you); return i < 0 ? null : $$('#hand .card')[i]; }
function guideStep() {
  if (!GUIDE.on || !G || G.over) return;
  const st = guideCur(), n = Math.min(GUIDE_STEPS.length, G.turn);
  if (st.you === 'over') { G.you.sc = Math.max(G.you.sc, overNeed(G.you)); G.foe.hp = Math.min(G.foe.hp, 55); }
  else { const c = CARDS[st.you]; if (G.you.en < c.cost) G.you.en = c.cost; }
  render();
  $$('.hl').forEach(e => e.classList.remove('hl'));
  $$('#hand .card, #overBtn').forEach(e => e.classList.add('gdim'));
  const el = guideEl(st); if (el) { el.classList.remove('gdim'); el.classList.add('hl'); }
  $('#tutT').textContent = st.say;
  $('#tutN').textContent = 'Paso ' + n + ' de ' + GUIDE_STEPS.length;
  $('#tutNext').hidden = true;
  $('#tutSkip').onclick = () => { AU.tap(); guideSkip(); };
  $('#tut').classList.remove('bot'); $('#tut').classList.add('guide');
  $('#tut').hidden = false;
}
function guideHide() { $('#tut').hidden = true; $$('.gdim').forEach(e => e.classList.remove('gdim')); $$('.hl').forEach(e => e.classList.remove('hl')); }
function guideNudge() { const el = guideEl(guideCur()); buzz(25); if (el) { el.classList.remove('nudge'); void el.offsetWidth; el.classList.add('nudge'); } }
function guideFoe() {
  const st = guideCur(), c = CARDS[st.foe];
  if (G.foe.en < c.cost) G.foe.en = c.cost;
  G.foe.sc = Math.min(G.foe.sc, 2);
  return c;
}
function guideDone() { try { localStorage.setItem('lito-guided', '1'); } catch (e) {} }
function guideStop() { GUIDE.on = false; guideHide(); $('#tutNext').hidden = false; $('#tut').classList.remove('guide'); }
function guideSkip() { guideStop(); guideDone(); duelToken++; busy = false; $('#end').hidden = true; show('home'); goPage('home', true); setTimeout(guidePost, 400); }
