  $('#emoPan').hidden = !$('#emoPan').hidden;
}
function emoShow(side, id) {
  const r = RBY[id]; if (!r) return;
  const host = $(side === 'foe' ? '#stageFoe' : '#stageYou'); if (!host) return;
  const rc = host.getBoundingClientRect(), el = document.createElement('div');
  el.className = 'emoflt ' + side + ' r-' + r[2]; el.textContent = r[1];
  el.style.left = Math.round(rc.left + rc.width / 2) + 'px'; el.style.top = Math.round(rc.top + rc.height * (side === 'foe' ? 0.15 : 0.1)) + 'px';
  document.body.appendChild(el); setTimeout(() => el.remove(), 2600);
  if (side === 'foe') AU.tap();
}
$('#emoBtn').addEventListener('click', () => { AU.tap(); emoPanel(); });
$('#emoPan').addEventListener('click', e => {
  const b = e.target.closest('[data-emo]'); if (!b || !PVP.on) return;
  $('#emoPan').hidden = true;
  if (Date.now() - emoLast < 2500) return; emoLast = Date.now();
  pvpSend({ t: 'emo', e: b.dataset.emo }); emoShow('you', b.dataset.emo);
});

