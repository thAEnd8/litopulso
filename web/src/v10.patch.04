// ---- buscar rival en línea (sin servidor: un canal común por el que se avisan) ----
const LOBBY = 'litopulso10/lobby';
var SEEK = { on: false };
function seekOpen(again) {
  const bad = validBuild(build); if (bad) { goPage('gar'); $('#gStatus').hidden = false; $('#gStatus').textContent = bad + ' Arréglalo para buscar rival.'; return; }
  AU.init(); if (!again) AU.tap();
  clearInterval(SEEK.timer);
  SEEK = { on: true, t0: Date.now(), peers: {}, pend: null, black: {}, timer: null, n: 0 };
  $('#seekBot').hidden = true; $('#seekT').textContent = 'Buscando rival';
  const r = ringOf(HX.p);
  $('#seekS').textContent = (r.k === 6 ? 'Centro' : 'Anillo ' + ROMAN[r.k - 1]) + ' · ' + r.n;
  $('#seekClk').textContent = '0:00';
  $('#seek').hidden = false;
  NET.start([LOBBY], seekMsg, () => {});
  SEEK.timer = setInterval(seekTick, 1000);
}
function seekClose() { SEEK.on = false; clearInterval(SEEK.timer); $('#seek').hidden = true; }
function seekCancel() { seekClose(); if (PVP.code) pvpCancel(); setTimeout(() => { if (!SEEK.on && !PVP.code) NET.stop(); }, 300); }
function seekTick() {
  if (!SEEK.on) return;
  const el = Date.now() - SEEK.t0, s = Math.floor(el / 1000), me = hxRing();
  $('#seekClk').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  if (!NET.up && s > 8) $('#seekT').textContent = 'Conectando…';
  else $('#seekT').textContent = 'Buscando rival';
  if (s >= 20) $('#seekBot').hidden = false;
  if (s % 2 === 0) NET.pub(LOBBY, { t: 'seek', sid: NET.me, ring: me, v: VER });
  if (SEEK.pend && Date.now() - SEEK.pend.at > 4000) { SEEK.black[SEEK.pend.to] = Date.now() + 10000; SEEK.pend = null; }
  if (SEEK.pend) return;
  const win = el < 8000 ? 0 : el < 16000 ? 1 : 5;
  const cand = Object.values(SEEK.peers).filter(p => Date.now() - p.seen < 5000 && Math.abs(p.ring - me) <= win && !(SEEK.black[p.sid] > Date.now()) && NET.me < p.sid)
    .sort((a, b) => Math.abs(a.ring - me) - Math.abs(b.ring - me))[0];
  if (cand) {
    let code = ''; for (let i = 0; i < 6; i++) code += ROOM_ABC[Math.floor(Math.random() * ROOM_ABC.length)];
    SEEK.pend = { to: cand.sid, code, at: Date.now(), ring: cand.ring };
    NET.pub(LOBBY, { t: 'match', to: cand.sid, from: NET.me, code, ring: me, v: VER });
  }
}
function seekMsg(m) {
  if (!SEEK.on || !m || m.v !== VER) return;
  if (m.t === 'seek' && m.sid && m.sid !== NET.me) { SEEK.peers[m.sid] = { sid: String(m.sid), ring: Math.min(6, Math.max(1, m.ring | 0)), seen: Date.now() }; return; }
  if (m.to !== NET.me) return;
  if (m.t === 'match' && !SEEK.pend && typeof m.code === 'string' && /^[A-Z]{6}$/.test(m.code)) {
    NET.pub(LOBBY, { t: 'acc', to: m.from, from: NET.me, code: m.code, ring: hxRing(), v: VER });
    seekGo('g', m.code, m.ring);
  } else if (m.t === 'acc' && SEEK.pend && m.code === SEEK.pend.code && m.from === SEEK.pend.to) seekGo('h', m.code, m.ring);
}
function seekGo(role, code, oppRing) {
  SEEK.on = false; clearInterval(SEEK.timer);
  $('#seekT').textContent = '¡Rival encontrado!'; $('#seekS').textContent = 'Conectando el duelo…'; $('#seekBot').hidden = true;
  pvpReset();
  PVP.role = role; PVP.code = code; PVP.state = 'wait'; PVP.ranked = true;
  PVP.oppRing = Math.min(6, Math.max(1, oppRing | 0)) || hxRing();
  pvpStartNet();
  AU.ready(); buzz([20, 40, 20]);
}
function seekBot() {
  seekCancel(); AU.tap();
  HXBOT = true; startDuel();
}
$('#seekBtn').addEventListener('click', () => seekOpen());
$('#seekCancel').addEventListener('click', () => { AU.tap(); seekCancel(); });
$('#seekBotBtn').addEventListener('click', seekBot);

// ---- reacciones en duelos en línea ----
let emoLast = 0;
