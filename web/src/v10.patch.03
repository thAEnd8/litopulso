function wheelSparks(color) {
  const el = $('#wSparks'); if (!el || RM) return;
  el.style.setProperty('--wg', color);
  el.innerHTML = [...Array(16)].map((_, i) => '<i style="--a:' + (-70 + i * 9.3 + Math.random() * 6).toFixed(0) + 'deg;--d:' + (50 + Math.random() * 60).toFixed(0) + 'px;--t:' + (0.5 + Math.random() * 0.4).toFixed(2) + 's"></i>').join('');
  setTimeout(() => { el.innerHTML = ''; }, 1100);
}
function spinTo(r, dur, done) {
  const opts = SLA.filter(s => s.k === r.o), pickS = opts[Math.floor(Math.random() * opts.length)];
  const mid = pickS.mid + (Math.random() - .5) * (pickS.a1 - pickS.a0) * .6;
  const reduce = RM, d = reduce ? 500 : dur;
  wheelRot = Math.ceil(wheelRot / 360) * 360 + 360 * (d > 4000 ? 7 : 5) - mid; const ww = document.querySelector('.wheelwrap'); ww.classList.add('spinning');
  const g = $('#wheelG'); g.style.transition = 'transform ' + d + 'ms cubic-bezier(.1,.62,.06,1)'; g.style.transform = 'rotate(' + wheelRot + 'deg)';
  const nT = reduce ? 0 : Math.round(d / 115); for (let k = 1; k <= nT; k++) setTimeout(() => AU.tap(), d * (1 - Math.pow(1 - k / nT, 1 / 3)) * .98);
  setTimeout(() => {
    spinning = false; ww.classList.remove('spinning');
    const col2 = r.o === 'r' ? '#ff5a4a' : r.o === 'b' ? '#4fa3ff' : (r.nw || r.o === 'x') ? '#ffd34a' : '#1fb5a8';
    ww.style.setProperty('--wg', col2); ww.classList.add('wglow', 'bump'); wheelSparks(col2); buzz([20, 30, 40]);
    setTimeout(() => ww.classList.remove('wglow', 'bump'), 1300);
    done(); renderCol();
  }, d + 80);
}
