};
function infoTile(kind, id) { return '<span class="info" role="button" tabindex="0" aria-label="Información" data-info="' + kind + ':' + id + '">i</span>'; }
function openInfo(kind, id) {
  const o = kind === 'card' ? CARDS[id] : kind === 'pass' ? PASSIVES[id] : ROBOTS[id], x = INFO[id] || {};
  $('#infoT').textContent = o.name;
  $('#infoK').textContent = kind === 'card' ? TYPE_NAME[o.type] + ' · cuesta ' + o.cost + ' de energía' + (cardLevel(id) > levelOf(xp).level ? ' · se desbloquea en el nivel ' + cardLevel(id) : '') : kind === 'pass' ? 'Pasiva (siempre activa)' : 'Robot · ' + o.short;
  $('#infoD').textContent = o.text;
  $('#infoP').textContent = x.pro ? 'Ventaja: ' + x.pro : '';
  $('#infoC').textContent = x.con ? 'Desventaja: ' + x.con : '';
  $('#info').hidden = false; $('#closeInfo').focus();
}
function infoClick(e) {
  const t = e.target.closest('.info'); if (!t) return false;
  e.stopPropagation(); AU.tap();
  const [k, id] = t.dataset.info.split(':'); openInfo(k, id); return true;
}
let diff = 'normal';
try { const d = localStorage.getItem('duelo-diff'); if (DIFFS[d]) diff = d; } catch (e) {}
function renderDiff() {
  $('#diffRow').innerHTML = DIFF_IDS.map(id => '<button role="radio" aria-checked="' + (id === diff) + '" class="' + (id === diff ? 'on' : '') + '" data-diff="' + id + '">' + DIFFS[id].name + '</button>').join('');
  const xt = XP_TABLE[diff];
  $('#diffText').textContent = 'Rival ' + DIFFS[diff].name.toLowerCase() + ': ' + DIFFS[diff].text + ' Ganas ' + xt.win + ' XP, empatas ' + xt.draw + ' y pierdes ' + xt.lose + '. ' + recText(diff);
}


