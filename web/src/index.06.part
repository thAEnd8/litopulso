function renderSnd() {
  $$('.snd').forEach(b => { b.classList.toggle('off', !AU.on); b.setAttribute('aria-pressed', String(AU.on)); b.title = AU.on ? 'Sonido activado' : 'Sonido apagado'; });
}
document.addEventListener('pointerdown', () => AU.init(), { once: true });
// ---- puente con la app de Android (Capacitor); en navegador no hace nada ----
const CAP = window.Capacitor, NATIVE = !!(CAP && CAP.isNativePlatform && CAP.isNativePlatform());
const plug = n => { if (!NATIVE) return null; try { return (CAP.Plugins && CAP.Plugins[n]) || (CAP.registerPlugin && CAP.registerPlugin(n)) || null; } catch (e) { return null; } };
const HAP = plug('Haptics');
function buzz(p) {
  try {
    if (HAP) { const a = Array.isArray(p) ? p : [p]; let t = 0; a.forEach((d, i) => { if (i % 2 === 0) setTimeout(() => HAP.vibrate({ duration: d }).catch(() => {}), t); t += d; }); return; }
    if (navigator.vibrate) navigator.vibrate(p);
  } catch (e) {}
}

// ---- robots (placeholders 2D; después van tus modelos 3D) ----
function robotSVG(id) {
  const extra = id === 'granito'
    ? '<rect class="s3" x="2" y="40" width="30" height="16" rx="4"/><rect class="s3" x="88" y="40" width="30" height="16" rx="4"/><rect class="s2" x="38" y="14" width="44" height="7" rx="2"/>'
    : id === 'cuarzo'
    ? '<path class="s3" d="M60 20 L51 1 L60 9 L69 1 Z"/><path class="s3" d="M24 48 L12 26 L32 42 Z"/><path class="s3" d="M96 48 L108 26 L88 42 Z"/>'
    : '<path class="crack" d="M60 18 V8"/><circle class="core" cx="60" cy="6" r="3.5"/>';
  return '<svg viewBox="0 0 120 140" aria-hidden="true">' +
    '<rect class="s2" x="38" y="102" width="16" height="28" rx="3"/><rect class="s2" x="66" y="102" width="16" height="28" rx="3"/>' +
    '<rect class="s3" x="33" y="127" width="26" height="9" rx="2"/><rect class="s3" x="61" y="127" width="26" height="9" rx="2"/>' +
    '<rect class="s2" x="12" y="54" width="16" height="40" rx="4"/><rect class="s2" x="92" y="54" width="16" height="40" rx="4"/>' +
    '<rect class="s3" x="8" y="90" width="24" height="15" rx="4"/><rect class="s3" x="88" y="90" width="24" height="15" rx="4"/>' +
    '<rect class="s1" x="28" y="50" width="64" height="56" rx="8"/>' +
    '<path class="crack" d="M34 58 L44 70 L38 80 L46 94"/><path class="crack" d="M86 60 L78 72 L84 84"/>' +
    '<circle class="core" cx="60" cy="78" r="11"/><circle class="core-in" cx="60" cy="78" r="5"/>' +
    '<rect class="s3" x="22" y="46" width="22" height="10" rx="3"/><rect class="s3" x="76" y="46" width="22" height="10" rx="3"/>' +
    '<rect class="s1" x="40" y="18" width="40" height="30" rx="7"/>' +
    '<rect class="core" x="46" y="28" width="28" height="9" rx="3"/>' + extra + '</svg>';
}


