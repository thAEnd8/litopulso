            over: 0.10, blunder: 0.70, foolish: 0.3, trust: 0,    explore: 0,    adapt: false, smart: false, econ: false, hp: 0.90 },
  normal: { name: 'Normal',  text: 'Cambia de estilo y a veces te lee, tiene 30 % más de vida y golpea +2. Ganarle cuesta (cerca de 28 %).',
            over: 0.50, blunder: 0.10, foolish: 0,   trust: 0.5,  explore: 0,    adapt: false, smart: false, econ: false, hp: 1.30, edge: 2 },
  hard:   { name: 'Difícil', text: 'Aprende cómo juegas, cambia de táctica, cuida su energía, tiene 44 % más de vida y golpea +3. Ganarle es raro (cerca de 20 %).',
            over: 1.00, blunder: 0,    foolish: 0,   trust: 0.95, explore: 0.06, adapt: true,  smart: true,  econ: true,  hp: 1.44, edge: 3 }
};
const DIFF_IDS = Object.keys(DIFFS);
const BASE_TYPES = ['attack', 'guard', 'dodge', 'skill'];
const PERSONAS = [
  { attack: 4, skill: 3, guard: 1, dodge: 1 },   // agresivo
  { attack: 1, skill: 2, guard: 3, dodge: 3 },   // defensivo
  { attack: 2, skill: 2, guard: 2, dodge: 2 }    // equilibrado
];
function topOf(counts) {
  let best = null, n = 0;
  for (const k in counts) if (counts[k] > n) { n = counts[k]; best = k; }
  return best;
}
function bestCard(opts, type, rng, smart) {
  const m = opts.filter(c => c.type === type);
  if (!m.length) return null;
  if (smart) return m.slice().sort((a, b) => (b.dmg || 0) - (a.dmg || 0) || a.cost - b.cost)[0];
  return m[Math.floor(rng() * m.length)];
}
function applyDifficulty(g, diff) {
  const D = DIFFS[diff] || DIFFS.normal;
  if (D.hp && D.hp !== 1) { g.foe.maxHp = Math.round(g.foe.maxHp * D.hp); g.foe.hp = g.foe.maxHp; }
  if (D.edge) g.foe.edge = (g.foe.edge || 0) + D.edge;
  return g;
}
function botPick(bot, hist, rng, diff, foe) {
  rng = rng || Math.random;
  const D = DIFFS[diff] || DIFFS.normal;
  const opts = afford(bot);
  if (!opts.length) return bot.hand.slice().sort((a, b) => a.cost - b.cost)[0];
  const ai = bot.ai || (bot.ai = { last: null, score: { last: 0, freq: 0, mk: 0, chain: 0 }, preds: {}, persona: PERSONAS[Math.floor(rng() * PERSONAS.length)], key: null, keyAge: 0 });
  const done = c => { ai.last = c.type; return c; };
  // aprende: qué predictor acertó con la última jugada del jugador
  if (hist.length) {
    const actual = hist[hist.length - 1];
    for (const k in ai.score) ai.score[k] = ai.score[k] * 0.8 + (ai.preds[k] === actual ? 1 : 0);
  }
  const P = {};
  if (hist.length) {
    const last = hist[hist.length - 1];
    P.last = last;
    const f = {}; hist.slice(-8).forEach(t => { f[t] = (f[t] || 0) + 1; }); P.freq = topOf(f);
    const m = {}; for (let i = 0; i < hist.length - 1; i++) if (hist[i] === last) m[hist[i + 1]] = (m[hist[i + 1]] || 0) + 1;
    if (Object.keys(m).length) P.mk = topOf(m);
    if (ai.last) P.chain = counterOf(ai.last);
  }
  ai.preds = P;
  let pred = null, conf = 0;
  const keys = Object.keys(P);
  if (keys.length) {
    if (D.adapt) {
      const k = keys.slice().sort((x, y) => ai.score[y] - ai.score[x])[0];
      pred = P[k]; conf = ai.score[k];
    } else {
      if (!ai.key || !P[ai.key] || ai.keyAge >= 3) { ai.key = keys[Math.floor(rng() * keys.length)]; ai.keyAge = 0; }
      ai.keyAge++; pred = P[ai.key]; conf = 1;
    }
  }
  const persona = () => {
    const types = [...new Set(opts.map(c => c.type))];
    let x = rng() * types.reduce((s, t) => s + (ai.persona[t] || 2), 0), pick = types[types.length - 1];
    for (const t of types) { x -= ai.persona[t] || 2; if (x < 0) { pick = t; break; } }
    return bestCard(opts, pick, rng, false);
  };
