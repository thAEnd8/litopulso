const takeOf = x => x.immune ? 0 : (x.take || 1) * (x.shield ? 0.5 : 1);
const MOD_IDS = Object.keys(MODS);
const ROBOTS = {
  petreo:  { name: 'Pétreo',  hp: 169, en: 5, color: '#3fd9d2', short: 'Equilibrado', text: '169 de vida y 5 de energía inicial.' },
  granito: { name: 'Granito', hp: 196, en: 3, color: '#b79cff', short: 'Resistente',  text: '196 de vida, pero empieza con solo 3 de energía.' },
  cuarzo:  { name: 'Cuarzo',  hp: 142, en: 8, color: '#8ee26b', short: 'Veloz',       text: '142 de vida, pero empieza con 8 de energía.' }
