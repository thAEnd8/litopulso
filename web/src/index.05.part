const dLock = (f, c) => (f.lockDodge || 0) > 0 && c.type === 'dodge' && f.hand.some(h => h.type !== 'dodge' && h.cost <= f.en);
function can(f, c) { if (dLock(f, c) || (f.locked && f.locked.includes(c.id))) return false; return c.type === 'over' ? f.sc >= overNeed(f) : c.cost <= f.en; }
function afford(f) {
