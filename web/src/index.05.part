}
// ciclo: Ataque > Esquiva > Habilidad > Defensa > Ataque
function counterOf(t) { return { attack: 'guard', guard: 'skill', skill: 'dodge', dodge: 'attack', over: 'dodge' }[t]; }
const DIFFS = {
