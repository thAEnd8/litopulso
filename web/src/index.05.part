// daño que `att` le hace a quien jugó `def`
function hit(att, def, atkF, defF) {
  let d = 0;
  if (att.type === 'attack') d = def.type === 'guard' ? 0 : att.dmg;
  else if (att.type === 'skill') d = def.type === 'dodge' ? 0 : att.dmg;
  else if (att.type === 'over') d = def.type === 'dodge' ? 0 : def.type === 'guard' ? (def.blockAll ? 0 : Math.round(att.dmg / 2)) : att.dmg;
  if (d > 0 && def.half && att.type === 'attack') d = Math.round(d / 2);
  if (d > 0 && atkF && defF && atkF.fury && atkF.hp < defF.hp) d += atkF.fury;
  if (d > 0 && atkF && atkF.edge) d += atkF.edge;
  if (d > 0 && att.type === 'over' && atkF && atkF.overAdd) d += atkF.overAdd;
  if (d > 0 && att.type === 'attack' && defF && defF.takeAtk) d += defF.takeAtk;
  return d;
}
function reflectOf(guardCard, attCard, F) { let r = guardCard.reflect && attCard.type === 'attack' ? guardCard.reflect : 0; if (r === 0 && guardCard.type === 'guard' && attCard.type === 'attack' && F && F.refAdd) r = F.refAdd; else if (r > 0 && F && F.refAdd) r += F.refAdd; return r; }

function tagOf(me, foe) {
  const big = foe === 'skill' || foe === 'over';
  switch (me) {
    case 'attack': return foe === 'guard' ? 'blocked' : 'landed';
    case 'skill': return foe === 'dodge' ? 'dodged' : foe === 'guard' ? 'broke' : 'landed';
    case 'over': return foe === 'dodge' ? 'dodged' : foe === 'guard' ? 'broke' : 'landed';
    case 'guard': return foe === 'attack' ? 'blocked' : big ? 'broken' : 'idle';
    default: return big ? 'dodged' : foe === 'attack' ? 'hit' : 'idle';
  }
}
function resolve(pc, bc, y, f) {
  return {
    toFoe: Math.round((hit(pc, bc, y, f) + reflectOf(pc, bc, y)) * takeOf(f)),
    toYou: Math.round((hit(bc, pc, f, y) + reflectOf(bc, pc, f)) * takeOf(y)),
    tagYou: tagOf(pc.type, bc.type),
    tagFoe: tagOf(bc.type, pc.type)
  };
}
// +1 con un acierto limpio, -1 (se pierde la racha) si te golpean sin golpear o tu golpe falla
function streakDelta(c, toFoe, toYou, tag) {
  if (c.type === 'over') return 0;
  if (toFoe > toYou) return 1;
  if (toYou > 0 && toFoe === 0) return -1;
  if (tag === 'blocked' || tag === 'dodged') return isDef(c) ? 1 : -1;
  return 0;
}

const EVENTS = {
  barajar: { name: 'Barajar', text: 'Cambias 4 de tus 5 cartas por otras al azar. Luego recuperas tu mano.' },
  corta:   { name: 'Mano corta', text: 'Solo puedes jugar 3 de tus 5 cartas.' },
  sobre:   { name: 'Sobrecarga rápida', text: 'La Sobrecarga se activa con racha 2.' },
  coraza:  { name: 'Vida doble', text: 'Todo el daño se reduce a la mitad.' },
  pesado:  { name: 'Golpes pesados', text: 'Todo el daño aumenta 50 %.' },
  ayuno:   { name: 'Recarga doble', text: 'Los dos recuperan el doble de energía por turno.' },
  llena:   { name: 'Energía llena', text: 'Los dos recuperan toda la energía ahora.', dur: 1 },
  cambio:  { name: 'Intercambio', text: 'Los dos intercambian su energía actual.', dur: 1 },
  racha:   { name: 'Racha regalada', text: 'Los dos ganan +2 de racha ahora.', dur: 1 },
  cura:    { name: 'Reparación', text: 'Los dos recuperan 15 % de su vida.', dur: 1 },
  colapso: { name: 'Colapso', text: 'Los dos pierden 30 % de su vida actual ahora.', dur: 1 },
  desgaste:{ name: 'Desgaste', text: 'Los dos pierden 7 de vida al final de cada turno.' },
  furia:   { name: 'Furia', text: 'Todo el daño se duplica.' }
};
const EV_LATE = ['colapso', 'desgaste', 'furia', 'pesado'], EV_AT = [10, 15, 20, 25];
const EV_IDS = Object.keys(EVENTS).filter(i => !['colapso', 'desgaste', 'furia'].includes(i));
const overNeed = f => f.scNeed || CFG.scMax;
function evPick(g, rnd, late) { rnd = rnd || g.rng || Math.random; const l = (late ? EV_LATE : EV_IDS).filter(i => i !== g.evLast); return l[Math.floor(rnd() * l.length)]; }
function evStart(g, rnd, id) {
  rnd = rnd || g.rng || Math.random; id = id || evPick(g, rnd);
  const fs = [g.you, g.foe];
  g.ev = { id, left: EVENTS[id].dur || 3, saved: [] }; g.evNew = id; g.evLast = id; g.evNext = null;
  if (id === 'cambio') { const t = g.you.en; g.you.en = g.foe.en; g.foe.en = t; }
  fs.forEach(f => {
    const rnd2 = rnd; { const rnd = f.rng || rnd2;
    if (id === 'barajar') {
      g.ev.saved.push(f.hand.slice());
      const pool = CARD_IDS.filter(i => !f.hand.some(h => h.id === i)), h = f.hand.slice();
      const keep = h.reduce((b, c, i) => c.cost < h[b].cost ? i : b, 0);
      let n = 0; for (let i = 0; i < h.length && n < 4; i++) { if (i === keep) continue; const k = Math.floor(rnd() * pool.length); h[i] = CARDS[pool.splice(k, 1)[0]]; n++; }
      f.hand = h;
    } else if (id === 'corta') {
      const keep = f.hand.reduce((b, c, i) => c.cost < f.hand[b].cost ? i : b, 0), idx = f.hand.map((_, i) => i).filter(i => i !== keep);
      f.locked = []; while (f.locked.length < 2) f.locked.push(f.hand[idx.splice(Math.floor(rnd() * idx.length), 1)[0]].id);
    } else if (id === 'sobre') f.scNeed = 2;
    else if (id === 'coraza') f.take = 0.5;
    else if (id === 'pesado') f.take = 1.5;
    else if (id === 'furia') f.take = 2;
    else if (id === 'colapso') f.hp = Math.max(1, f.hp - Math.round(f.hp * 0.3));
    else if (id === 'ayuno') { g.ev.saved.push(f.regen); f.regen = f.regen * 2; }
    else if (id === 'llena') f.en = CFG.maxEnergy;
    else if (id === 'racha') f.sc = Math.min(CFG.scMax, f.sc + 2);
    else if (id === 'cura') f.hp = Math.min(f.maxHp, f.hp + Math.round(f.maxHp * 0.15));
    }
  });
}
function evEnd(g) {
  const id = g.ev.id;
  [g.you, g.foe].forEach((f, k) => {
    if (id === 'barajar') f.hand = g.ev.saved[k]; else if (id === 'corta') f.locked = null; else if (id === 'sobre') { if (f.arNeed) f.scNeed = f.arNeed; else delete f.scNeed; } else if (id === 'coraza' || id === 'pesado' || id === 'furia') f.take = 1; else if (id === 'ayuno') f.regen = g.ev.saved[k];
