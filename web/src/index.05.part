    }
  }
  if (pred && (conf >= (D.adapt ? 0.9 : 0)) && rng() < D.trust) {
    const c = bestCard(opts, counterOf(pred), rng, D.smart);
    if (c) return done(c);
  }
  return done(persona());
}

// ---------- equipos ----------
function validBuild(b) {
  if (!b || !ROBOTS[b.robot]) return 'Elige un robot.';
  const cards = b.cards || [], pass = b.passives || [];
  if (cards.length !== CFG.handSize || new Set(cards).size !== cards.length || cards.some(id => !CARDS[id] || !POOL.includes(id))) return 'Elige ' + CFG.handSize + ' cartas (' + cards.length + '/' + CFG.handSize + ').';
  if (pass.length !== CFG.passiveSlots || new Set(pass).size !== pass.length || pass.some(id => !PASSIVES[id] || PASSIVES[id].robot !== b.robot)) return 'Elige ' + CFG.passiveSlots + ' pasivas (' + pass.length + '/' + CFG.passiveSlots + ').';
  { const ms = b.mods || []; if (ms.length > 3 || new Set(ms).size !== ms.length || ms.some(id => !MODS[id] || (MODS[id].part === 'spec' && MODS[id].robot !== b.robot))) return 'Módulos no válidos.'; const uni = ms.filter(id => MODS[id].part !== 'spec'); if (uni.length > 2 || new Set(uni.map(id => MODS[id].part)).size !== uni.length || ms.filter(id => MODS[id].part === 'spec').length > 1) return 'Módulos no válidos.'; }
  if (!cards.some(id => CARDS[id].cost <= 2)) return 'Incluye al menos una carta de costo 2 o menos.';
  return '';
}
function shuffle(a, rng) { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor((rng || Math.random)() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function randomBuild(rng) {
  for (;;) {
    const robot = shuffle(ROBOT_IDS, rng)[0];
    const b = { robot, cards: shuffle(POOL, rng).slice(0, CFG.handSize), passives: shuffle(passivesOf(robot), rng).slice(0, CFG.passiveSlots) };
    b.cards.sort((a, c) => CARD_IDS.indexOf(a) - CARD_IDS.indexOf(c));
    if (!validBuild(b)) return b;
  }
}
function makeFighter(b) {
  const r = ROBOTS[b.robot], P = b.passives.map(id => PASSIVES[id]), M = (b.mods || []).filter(id => MODS[id]).map(id => MODS[id]);
  const sum = k => P.reduce((t, p) => t + (p[k] || 0), 0) + M.reduce((t, p) => t + (p[k] || 0), 0);
  const hp = Math.max(30, r.hp + sum('hp'));
  return { robot: b.robot, hp, maxHp: hp, en: Math.max(0, Math.min(CFG.maxEnergy, r.en + sum('start'))), sc: 0, hand: b.cards.map(id => CARDS[id]), passives: b.passives.slice(), mods: (b.mods || []).slice(), regen: Math.max(0, CFG.regen + sum('regen')), idle: sum('idle'), bonus: Math.max(CFG.bonus, ...P.map(p => p.def || 0)) + M.reduce((t, p) => t + (p.bonus || 0), 0), fury: sum('fury'), edge: sum('edge'), overAdd: sum('overAdd'), takeAtk: sum('takeAtk'), refAdd: sum('refAdd'), leak: sum('leak') };
}
function newGame(buildYou, buildFoe) {
  return { turn: 1, you: makeFighter(buildYou), foe: makeFighter(buildFoe), hist: [], histFoe: [], over: false, result: null, dealt: 0, taken: 0 };
}
function applyTurn(g, pc, bc) {
  const y = g.you, f = g.foe;
  const r = resolve(pc, bc, y, f);
  y.en -= pc.cost; f.en -= bc.cost;
  if (pc.type === 'over') y.sc = 0;
  if (bc.type === 'over') f.sc = 0;
  g.taken += Math.min(y.hp, r.toYou); g.dealt += Math.min(f.hp, r.toFoe);
  y.hp = Math.max(0, y.hp - r.toYou); f.hp = Math.max(0, f.hp - r.toFoe);
  const good = t => t === 'blocked' || t === 'dodged';
  r.bonusYou = isDef(pc) && good(r.tagYou) ? y.bonus : 0;
  r.bonusFoe = isDef(bc) && good(r.tagFoe) ? f.bonus : 0;
  const sY = (c, mine) => isDef(c) ? good(mine ? r.tagYou : r.tagFoe) : (mine ? r.toFoe : r.toYou) > 0;
  let setY = 0, setF = 0;
  if (pc.gain && sY(pc, true)) y.en += pc.gain; if (bc.gain && sY(bc, false)) f.en += bc.gain;
  if (pc.drain && sY(pc, true)) f.en = Math.max(0, f.en - pc.drain); if (bc.drain && sY(bc, false)) y.en = Math.max(0, y.en - bc.drain);
  if (pc.missLoss && bc.type === 'guard') y.en = Math.max(0, y.en - pc.missLoss); if (bc.missLoss && pc.type === 'guard') f.en = Math.max(0, f.en - bc.missLoss);
  if (pc.lockDodge && sY(pc, true)) setF = 2; if (bc.lockDodge && sY(bc, false)) setY = 2;
  y.en = Math.min(CFG.maxEnergy, y.en + (pc.noRegen ? 0 : y.regen) + r.bonusYou + (r.toYou === 0 && r.toFoe === 0 ? y.idle : 0));
  f.en = Math.min(CFG.maxEnergy, f.en + (bc.noRegen ? 0 : f.regen) + r.bonusFoe + (r.toYou === 0 && r.toFoe === 0 ? f.idle : 0));
  const hadY = y.sc, hadF = f.sc;
  r.scYou = streakDelta(pc, r.toFoe, r.toYou, r.tagYou);
  r.scFoe = streakDelta(bc, r.toYou, r.toFoe, r.tagFoe);
  y.sc = r.scYou === 1 ? Math.min(CFG.scMax, y.sc + 1) : r.scYou === -1 ? 0 : y.sc;
  f.sc = r.scFoe === 1 ? Math.min(CFG.scMax, f.sc + 1) : r.scFoe === -1 ? 0 : f.sc;
  if (y.leak && y.sc === 3 && hadY < 3) y.hp = Math.max(1, y.hp - y.leak);
  if (f.leak && f.sc === 3 && hadF < 3) f.hp = Math.max(1, f.hp - f.leak);
  r.lostYou = r.scYou === -1 && hadY > 0;
  r.lostFoe = r.scFoe === -1 && hadF > 0;
  r.fullYou = y.sc === CFG.scMax && hadY < CFG.scMax;
  r.fullFoe = f.sc === CFG.scMax && hadF < CFG.scMax;
  if ((y.lockDodge || 0) > 0) y.lockDodge--; if ((f.lockDodge || 0) > 0) f.lockDodge--;
  if (setY) y.lockDodge = 1; if (setF) f.lockDodge = 1;
  g.hist.push(pc.type); g.histFoe.push(bc.type);
  if (y.hp <= 0 || f.hp <= 0 || g.turn >= CFG.maxTurns) {
    g.over = true;
    g.result = y.hp > f.hp ? 'win' : y.hp < f.hp ? 'lose' : 'draw';
  } else {
    g.turn++;
    if (g.ev && g.ev.id === 'desgaste') { g.you.hp = Math.max(1, g.you.hp - 7); g.foe.hp = Math.max(1, g.foe.hp - 7); }
    if (g.ev && --g.ev.left <= 0) evEnd(g);
    if ((g.evAt || EV_AT).includes(g.turn) && !g.ev) evStart(g, null, g.evNext);
    else if ((g.evAt || EV_AT).includes(g.turn + 1) && !g.ev) g.evNext = evPick(g, null, g.turn + 1 >= 20);
  }
  for (const x of [g.you, g.foe]) { if (x._boost) { x.edge -= x._boost; x._boost = 0; } x.shield = x.immune = false; }
  return r;
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = { bossUse, useMod, modWhy, EV_AT, ROBOTS, EVENTS, EV_IDS, evStart, evEnd, MODS, MOD_IDS, passivesOf, applyDifficulty, setPool, DIFFS, DIFF_IDS, CFG, CARDS, OVER, PASSIVES, ROBOTS, CARD_IDS, PASSIVE_IDS, ROBOT_IDS, TYPE_NAME, hit, resolve, streakDelta, can, afford, botPick, validBuild, randomBuild, makeFighter, newGame, applyTurn, statOf };
}

// ---------- interfaz ----------
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const clone = o => JSON.parse(JSON.stringify(o));
const RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
const sleep = ms => new Promise(r => setTimeout(r, RM ? ms * 0.4 : ms));

const ICONS = {
  attack: '<path d="M5 4 L11 20 M10 4 L16 20 M15 4 L21 20"/>',
  guard: '<path d="M12 3 L19 6 V12 C19 16.5 16 19.5 12 21 C8 19.5 5 16.5 5 12 V6 Z"/>',
  dodge: '<path d="M19 5 C11 5 6 9 6 18 M6 18 L2.5 14.5 M6 18 L9.5 14.5"/>',
  skill: '<path d="M12 2 L14 9 L21 7 L16 12 L21 17 L14 15 L12 22 L10 15 L3 17 L8 12 L3 7 L10 9 Z"/>',
  over: '<path d="M13 2 L4 14 H11 L10 22 L20 9 H13 Z"/>'
};
const TCOL = { attack: '#ff8a3d', guard: '#4aa3ff', dodge: '#1fb5a8', skill: '#b48aff', over: '#ffd34a' };
const cardFace = c => '<span class="cico" style="--tc:' + TCOL[c.type] + '">' + icon(c.type) + '</span><b>' + c.name + '</b>';
const icon = t => '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICONS[t] + '</svg>';

// ---- sonido sintetizado, sin archivos ----
const AU = {
  ctx: null, on: true,
  init() {
    try {
      if (!this.ctx) { const C = window.AudioContext || window.webkitAudioContext; if (C) this.ctx = new C(); }
      if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
    } catch (e) {}
  },
  tone(f0, f1, dur, type, vol, delay) {
    if (!this.on || !this.ctx) return;
    try {
      const t = this.ctx.currentTime + (delay || 0);
      const o = this.ctx.createOscillator(), g = this.ctx.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(f0, t);
      o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur);
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g); g.connect(this.ctx.destination);
      o.start(t); o.stop(t + dur + 0.03);
    } catch (e) {}
  },
  noise(dur, vol, freq, delay) {
    if (!this.on || !this.ctx) return;
    try {
      const c = this.ctx, t = c.currentTime + (delay || 0);
      const n = Math.max(1, Math.floor(c.sampleRate * dur));
      const buf = c.createBuffer(1, n, c.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
      const s = c.createBufferSource(); s.buffer = buf;
      const f = c.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = 0.8;
      const g = c.createGain(); g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      s.connect(f); f.connect(g); g.connect(c.destination); s.start(t);
    } catch (e) {}
  },
  pick()   { this.tone(520, 760, .08, 'triangle', .12); },
  tap()    { this.tone(380, 520, .06, 'triangle', .09); },
  reveal() { this.noise(.2, .12, 1800); },
  swing()  { this.noise(.18, .12, 2200); },
  skill()  { this.tone(200, 900, .32, 'sawtooth', .09); this.noise(.3, .08, 1200); },
  over()   { this.tone(70, 28, .9, 'sawtooth', .28); this.tone(300, 1300, .45, 'square', .07); this.noise(.7, .22, 350); },
  hit(d)   { this.tone(170, 45, .26, 'sine', .38); this.noise(.12, .25, 500); if (d >= 35) this.tone(95, 28, .55, 'sawtooth', .18); },
  block()  { this.tone(900, 520, .14, 'square', .08); this.noise(.06, .16, 3000); },
  dodge()  { this.noise(.22, .12, 2600); this.tone(420, 940, .16, 'sine', .08); },
  gain()   { this.tone(600, 820, .1, 'triangle', .1); },
  ready()  { this.tone(440, 880, .16, 'triangle', .14); this.tone(660, 1320, .22, 'triangle', .14, .12); },
  ko()     { this.tone(120, 26, .9, 'sine', .4); this.noise(.5, .25, 250); this.tone(70, 30, .7, 'sawtooth', .2, .12); this.noise(.25, .2, 1500, .02); },
  intro()  { this.noise(.4, .07, 700); this.tone(220, 330, .35, 'sine', .1); this.tone(330, 495, .35, 'sine', .07, .15); },
  fight()  { this.tone(90, 45, .45, 'sine', .35); this.noise(.12, .1, 1200); [523, 659, 784].forEach(f => this.tone(f, f, .5, 'triangle', .08, .06)); },
  nav()    { this.tone(300, 440, .05, 'sine', .07); },
  evt()    { this.tone(520, 380, .2, 'triangle', .12); this.tone(520, 380, .2, 'triangle', .12, .24); },
  win()    { [523, 659, 784, 1047].forEach((f, i) => this.tone(f, f, .22, 'triangle', .14, i * .14)); },
  half()   { this.tone(520, 330, .18, 'square', .1); this.tone(390, 230, .3, 'square', .1, .2); this.tone(80, 40, .22, 'sine', .4, .05); this.tone(80, 40, .22, 'sine', .4, .38); },
  lose()   { this.tone(330, 90, 1, 'sawtooth', .13); }
};
try { if (localStorage.getItem('duelo-snd') === '0') AU.on = false; } catch (e) {}
