  const m = MODS[id], f = g[side], o = g[side === 'you' ? 'foe' : 'you'];
  g.used = g.used || { you: {}, foe: {} }; g.used[side][id] = 1;
  if (m.costHp) f.hp -= m.costHp;
  if (m.costEn) f.en -= m.costEn;
  if (id === 'm_nuc') f.sc = CFG.scMax;
  else if (id === 'm_antena') o.en = Math.max(0, o.en - 4);
  else if (id === 'm_blind') f.shield = true;
  else if (id === 'm_reac') f.en = Math.min(CFG.maxEnergy, f.en + 5);
  else if (id === 'm_banco') {
    const pool = CARD_IDS.filter(i => !f.hand.some(h => h.id === i)), h = f.hand.slice(), keep = h.reduce((b, c, i) => c.cost < h[b].cost ? i : b, 0);
    let n = 0; for (let i = 0; i < h.length && n < 3; i++) { if (i === keep) continue; h[i] = CARDS[pool.splice(Math.floor(rnd() * pool.length), 1)[0]]; n++; }
    f.hand = h;
  }
  else if (id === 'm_imp') f.sc = Math.min(CFG.scMax, f.sc + 3);
  else if (id === 'm_anc') f.immune = true;
  else if (id === 'm_salto') { f.edge = (f.edge || 0) + 25; f._boost = (f._boost || 0) + 25; }
  else if (id === 's_petreo') f.hp = Math.min(f.maxHp, f.hp + Math.round(f.maxHp * 0.2));
  else if (id === 's_granito') o.hp = Math.max(1, o.hp - 30);
  else if (id === 's_cuarzo') { const t = Math.min(3, o.en); o.en -= t; f.en = Math.min(CFG.maxEnergy, f.en + 3); }
  return true;
}
function bossUse(g, rnd) {
  rnd = rnd || Math.random;
  const f = g.foe, p = g.you, out = [], hpPct = f.hp / f.maxHp;
  for (const id of (f.mods || [])) {
    if (modWhy(g, 'foe', id)) continue;
    let ok = false;
    if (id === 'm_anc') ok = p.sc >= overNeed(p) || (p.en >= 8 && rnd() < 0.3);
    else if (id === 'm_reac') ok = f.en <= 2 && hpPct > 0.5;
    else if (id === 'm_nuc') ok = f.sc >= 2 && hpPct > 0.4 && rnd() < 0.5;
    else if (id === 'm_blind') ok = p.en >= 6 && rnd() < 0.4;
    else if (id === 'm_antena') ok = p.en >= 6 && hpPct > 0.5;
    else if (id === 's_petreo') ok = hpPct < 0.45;
    else if (id === 's_granito') ok = g.turn >= 6 && p.hp > 40 && rnd() < 0.35;
    else if (id === 's_cuarzo') ok = p.en >= f.en + 3;
