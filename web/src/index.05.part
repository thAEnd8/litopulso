const CARD_IDS = Object.keys(CARDS), PASSIVE_IDS = Object.keys(PASSIVES), ROBOT_IDS = Object.keys(ROBOTS);
function passivesOf(robotId) { return PASSIVE_IDS.filter(id => PASSIVES[id].robot === robotId); }

let POOL = CARD_IDS.slice();
function setPool(ids) { POOL = ids.slice(); CFG.handSize = Math.min(5, POOL.length); }
function isDef(c) { return c.type === 'guard' || c.type === 'dodge'; }
function statOf(c) {
  if (c.dmg && (c.gain || c.drain || c.lockDodge || c.missLoss)) return '−' + c.dmg + ' +';
  if (c.gain || c.drain) return (c.type === 'guard' ? 'Frena' : 'Evita') + ' +';
  if (c.blockAll) return 'Frena Sobrec.';
  if (c.dmg) return '−' + c.dmg;
  if (c.reflect) return 'Frena +' + c.reflect;
