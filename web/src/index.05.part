  if (bot.sc >= overNeed(bot)) {
    let p = D.over;
    if (D.adapt && pred === 'dodge' && conf >= 1.2) p = 0.3;
    if (D.adapt && foe && foe.hp <= CFG.overDmg && pred !== 'dodge') p = 1;
    if (rng() < p) return done(OVER);
  }
