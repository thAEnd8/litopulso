.hs.empty { border-style: dashed; color: var(--muted); font-size: 10.5px; cursor: default; background: transparent; }
.hs .cost { top: 3px; left: 3px; width: 16px; height: 16px; font-size: 10px; line-height: 16px; }
.hs .cico { width: 26px; height: 30px; } .hs b { font-size: 9.5px; }
.hxp { width: 44px; height: 50px; } .pk.on .hxp { width: 60px; height: 68px; } .pk.on .hxp::before { inset: 3px; } .pick { gap: 10px; }
.hxp { width: 52px; height: 59px; } .pk.on .hxp { width: 70px; height: 80px; } .hxp .mini { width: 82%; height: 82%; } .pick { gap: 12px; }

.mslots{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:8px}
.mslot{border:1px dashed #ffffff30;border-radius:var(--cut);padding:6px 8px;display:flex;flex-direction:column;gap:2px;min-width:0;background:#ffffff08}
.mslot.f{border:1px solid var(--accent,#ff8a2a);background:#ff8a2a14}.mslot.lk{opacity:.5}
.mslot small{font-size:10px;opacity:.7;text-transform:uppercase;letter-spacing:.06em}.mslot b{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ptile.mt{position:relative}.ptile.mt em{font-style:normal;font-size:10px;opacity:.7;text-transform:uppercase;letter-spacing:.06em}
.ptile.mt.lock{opacity:.45}.ptile.mt .con{color:#ff7a88}.lkt{position:absolute;top:6px;right:8px;font-size:10px;color:#ffd34a}

.gtabs{display:flex;gap:6px;margin:4px 0 10px;overflow-x:auto;scrollbar-width:none}.gtabs .chip{font-size:12.5px;padding:6px 13px}.gtabs .own{margin-left:auto}
.swt{margin-left:auto;display:flex;align-items:center;gap:7px;flex:none;background:none;border:0;color:inherit;font:inherit;font-size:12px;padding:4px 0 4px 6px}
.swt i{position:relative;width:34px;height:18px;border-radius:99px;background:#ffffff26;border:1px solid var(--line,#8886);transition:background .2s}
.swt i::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#cfd6e0;transition:transform .2s}
.swt.on i{background:var(--accent,#6cf);border-color:transparent}.swt.on i::after{transform:translateX(16px);background:#fff}
.gtabs{overflow-x:visible;flex-wrap:nowrap}.gtabs .chip{padding:6px 10px}
.steps{display:flex;flex-direction:column;align-items:center;gap:4px;margin:2px 0 6px}.steps small{font-size:11px;opacity:.75;letter-spacing:.06em;text-transform:uppercase}
.steps div{display:flex;align-items:center;gap:7px}.steps i{width:22px;height:10px;border-radius:3px 6px 3px 6px;background:#ffffff22;border:1px solid #ffffff30;transform:skewX(-18deg)}
.steps i.f{background:var(--accent,#6cf);border-color:transparent;box-shadow:0 0 8px var(--accent,#6cf)}
.steps .bs{font:800 11px var(--font-display,inherit);letter-spacing:.08em;padding:3px 8px;border-radius:4px 10px 4px 10px;border:1px solid #ffd34a88;color:#ffd34a}.steps .bs.f{background:#ffd34a;color:#2c1c00;box-shadow:0 0 12px #ffd34a}

.chap{border:1px solid #ffffff26;border-radius:var(--cut);padding:12px;margin:10px 0;display:flex;flex-direction:column;gap:8px;background:#ffffff08}.chap b{font:700 14px var(--font-display);letter-spacing:.04em}.chap small{opacity:.75;font-size:12px}.chap.lock{opacity:.45;border-style:dashed}
.steps2{display:flex;align-items:center;gap:8px;margin:4px 0}.steps2 i{flex:1;height:34px;display:grid;place-items:center;border-radius:4px 12px 4px 12px;background:#ffffff14;border:1px solid #ffffff2a;font-style:normal}.steps2 i u{text-decoration:none;font:700 13px var(--font-display);opacity:.6}
.steps2 i.f{background:var(--accent,#6cf);border-color:transparent;color:#000;box-shadow:0 0 10px var(--accent,#6cf)}.steps2 i.f u{opacity:1}
.steps2 .bs{font:800 12px var(--font-display);letter-spacing:.08em;padding:9px 10px;border-radius:4px 12px 4px 12px;border:1px solid #ffd34a88;color:#ffd34a}.steps2 .bs.f{background:#ffd34a;color:#2c1c00;box-shadow:0 0 12px #ffd34a}

.evbox{margin:4px auto 0;max-width:340px;text-align:center;font-size:12px;padding:5px 10px;border:1px solid #ffd34a88;border-radius:4px 14px 4px 14px;background:#ffd34a14;color:#ffd34a;display:flex;flex-direction:column;gap:1px}.evbox small{color:var(--fg);opacity:.8;font-size:11px}
.evbox.pop{animation:evpop .7s ease}@keyframes evpop{0%{transform:scale(.6);opacity:0;box-shadow:0 0 0 #ffd34a}50%{transform:scale(1.08);box-shadow:0 0 18px #ffd34a}100%{transform:scale(1);opacity:1}}

.logp{position:fixed;inset:0;z-index:60;background:#000a;display:grid;place-items:center;padding:16px}.logp[hidden]{display:none}
.logbox{width:min(360px,100%);max-height:70vh;display:flex;flex-direction:column;background:var(--bg,#0f141b);border:1px solid #ffffff30;border-radius:4px 18px 4px 18px;padding:12px}
.logh{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font:700 14px var(--font-display)}
#logList{list-style:none;margin:0;padding:0;overflow:auto;display:flex;flex-direction:column;gap:6px}
#logList li{display:grid;grid-template-columns:34px 1fr;gap:2px 8px;font-size:12px;padding:6px 8px;border-radius:4px 10px 4px 10px;background:#ffffff0a}
#logList li b{grid-row:span 2;color:var(--you,#6cf)}#logList li em{font-style:normal;font-weight:700}#logList li i{grid-column:2;font-style:normal;color:#ffd34a;font-size:11px}

.modrow{display:flex;gap:6px;margin:6px 0 2px}.modb{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;text-align:left;padding:6px 8px;border-radius:4px 12px 4px 12px;border:1px solid #ff8a2a99;background:#ff8a2a14;color:inherit;font:inherit}
.modb b{font-size:11.5px;color:#ffb36b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.modb small{font-size:9.5px;opacity:.8;line-height:1.2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.modb.off{opacity:.45}.modb:disabled{opacity:.3}

.arrow{display:flex;gap:6px;justify-content:center;margin:2px 0}.arrow button{width:36px;height:30px;border-radius:4px 12px 4px 12px;border:1px solid #ffffff2a;background:#ffffff0c;color:inherit;font:700 13px var(--font-display)}
.arrow button.on{background:var(--you);color:#06121a;border-color:transparent}.arrow button.lk{opacity:.5}
.arena.battle.ar2{background:radial-gradient(ellipse at 50% 100%,#8a5a2a55,transparent 70%)}
.arena.battle.ar3{background:radial-gradient(ellipse at 50% 100%,#3aa0ff44,transparent 70%)}
.arena.battle.ar4{background:radial-gradient(ellipse at 50% 100%,#b06bff55,transparent 70%)}
.arena.battle.ar5{background:radial-gradient(ellipse at 50% 100%,#ff4a5a55,transparent 70%),radial-gradient(ellipse at 50% 0%,#ffd34a22,transparent 60%)}
</style>

