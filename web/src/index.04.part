    <div class="setrow"><i class="shx">♪</i><div class="stx"><b>Sonido</b><small>Efectos y música</small></div><button class="snd tg" aria-label="Sonido" aria-pressed="true"></button></div>
    <div class="sech">Navegación</div>
    <div class="navopts" id="navOpts" role="radiogroup" aria-label="Estilo de navegación"><button class="no" role="radio" data-nav="bar">Barra fija</button><button class="no" role="radio" data-nav="fan">Abanico hexagonal</button><button class="no" role="radio" data-nav="side">Menú lateral</button><button class="no" role="radio" data-nav="fab">Botón flotante</button></div>
