    <div class="xpbox"><div class="xpbar"><i id="xpFill"></i></div><p class="sub" id="xpText"></p></div>
    <div class="lvlup" id="endUp" hidden></div>
    <button class="btn" id="again">Revancha</button>
    <button class="btn ghost" id="endGarage">Garaje</button>
    <button class="btn ghost" id="endHome">Inicio</button>
  </div>
</div>

<div class="sheet" id="pvp" hidden>
  <div class="sheet-card" role="dialog" aria-label="Duelo en línea">
    <h2>Duelo en línea</h2>
    <div id="pvpMenu">
      <p class="sub">Reta a un amigo, cada quien en su teléfono. Los dos necesitan internet. Juegas con tu equipo del Garaje, sin módulos, y cada turno tiene 40 segundos.</p>
      <button class="btn" id="pvpHost">Crear sala</button>
      <p class="sub pvpor">o escribe el código de tu amigo</p>
      <div class="pvpjoin"><input id="pvpCode" class="field" maxlength="4" placeholder="ABCD" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Código de sala"><button class="btn" id="pvpJoin">Unirme</button></div>
      <p class="sub" id="pvpRec"></p>
    </div>
    <div id="pvpWait" hidden>
      <p class="sub" id="pvpWaitT"></p>
      <div class="pvpcode" id="pvpShow"></div>
      <p class="sub pvpst" id="pvpSt">Conectando&hellip;</p>
    </div>
    <p class="sub pvperr" id="pvpErr" aria-live="polite"></p>
    <button class="btn ghost" id="pvpClose">Cerrar</button>
  </div>
</div>

<div class="sheet" id="info" hidden>
  <div class="sheet-card" role="dialog" aria-label="Información">
    <h2 id="infoT"></h2>
    <p class="sub" id="infoK"></p>
    <p id="infoD"></p>
    <p class="pro" id="infoP"></p>
    <p class="con" id="infoC"></p>
    <button class="btn" id="closeInfo">Entendido</button>
  </div>
</div>

<div class="tut" id="tut" hidden>
  <div class="tut-card" role="dialog" aria-label="Asistente">
    <div class="tut-av" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" class="av-o"/><circle cx="20" cy="20" r="7" class="av-i"/></svg></div>
    <div class="tut-body">
      <b>Asistente</b>
      <p id="tutT"></p>
      <div class="tut-row"><span id="tutN"></span><button class="btn-link" id="tutSkip">Saltar</button><button class="tut-next" id="tutNext">Siguiente</button></div>
    </div>
  </div>
</div>




<div class="sheet" id="theme" hidden>
  <div class="sheet-card" role="dialog" aria-label="Color de la interfaz">
    <h2>Color de la interfaz</h2>
    <div class="swrow" id="themeRow"></div>
    <p class="sub" id="themeName"></p>
    <button class="btn" id="closeTheme">Listo</button>
  </div>
</div>

