.gpick { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 6px; padding-top: 10px; border-top: 1px dashed var(--line); }
.gpl { font-size: 11px; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
.gsw { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.gsw .pk { width: auto; padding: 6px 2px 5px; display: flex; flex-direction: column; align-items: center; gap: 1px; border: 1px solid var(--line); border-radius: 4px 12px 4px 12px; background: var(--bg); cursor: pointer; opacity: .75; }
.gsw .pk .mini { width: 38px; height: 44px; display: block; margin-bottom: 2px; }
.gsw .pk b { font: 700 12px var(--font-display); color: var(--fg); }
.gsw .pk small { font-size: 9.5px; color: var(--muted); letter-spacing: 0; }
.gsw .pk.on { opacity: 1; border: 2px solid var(--c); background: color-mix(in srgb, var(--c) 10%, var(--bg)); box-shadow: 0 0 10px color-mix(in srgb, var(--c) 40%, transparent); }
.gsw .pk.on b { color: var(--c); }
