$('#bossBtn').addEventListener('click', () => { if ((col.st | 0) >= 5) { forceBoss = true; startDuel(); } });
async function startDuel() {
  if (!PVP.on && validBuild(build)) { openGarage(); return; }
  AU.init(); AU.ready();
  const tok = ++duelToken;
  setColor(build.robot);
  foeBuild = PVP.on ? PVP.opp.b : randomBuild();
  halfShown = { you: false, foe: false }; halfNote = { you: false, foe: false };
  isBoss = !PVP.on && forceBoss && (col.st | 0) >= 5; forceBoss = false;
  const ch = chapNow();
  if (isBoss) foeBuild.mods = ['m_anc', 'm_reac', 's_' + foeBuild.robot].concat(['m_blind', 'm_antena', 'm_nuc'].slice(0, Math.min(ch - 1, 3)));
  arenaK = PVP.on ? PVP.arena : isBoss ? ch : selArena;
  G = PVP.on ? newGame(PVP.myB, foeBuild) : applyDifficulty(newGame(build, foeBuild), diff);
  if (PVP.on) {
    G.rng = mulberry(PVP.seed);
    const rH = mulberry(PVP.seed ^ 0x9e3779b9), rG = mulberry(PVP.seed ^ 0x85ebca6b);
    G.you.rng = PVP.role === 'h' ? rH : rG; G.foe.rng = PVP.role === 'h' ? rG : rH;
  }
  if (isBoss) { G.foe.maxHp = Math.round(G.foe.maxHp * (1.1 + 0.1 * ch)); G.foe.hp = G.foe.maxHp; G.foe.edge = (G.foe.edge || 0) + Math.ceil(ch / 2); }
  applyArena(G, arenaK);
  { const bt = document.querySelector('.arena.battle'); bt.className = 'arena battle ar' + arenaK; }
  busy = true;
  $('#end').hidden = true; $('#rules').hidden = true; $('#ko').hidden = true;
  show('duel');
  $('#foe').innerHTML = fighterStats('foe', G.foe, PVP.on ? PVP.opp.name : isBoss ? 'JEFE ' + ch : 'Rival ' + DIFFS[diff].name);
  $('#you').innerHTML = fighterStats('you', G.you, 'Tú');
  $('#stageFoe').innerHTML = fighterRob('foe', G.foe); $('#stageYou').innerHTML = fighterRob('you', G.you);
  $('#hand').classList.remove('deal');
  $('#hand').style.gridTemplateColumns = 'repeat(' + G.you.hand.length + ', minmax(0, 1fr))';
  drawHand();
  render();
  setSlot($('#slotFoe'), 'back', '?');
  setSlot($('#slotYou'), 'empty', 'Elige');
  $('#msg').textContent = arenaK > 1 ? 'Arena: ' + ARENAS[arenaK - 1].n + '. ' + ARENAS[arenaK - 1].r : '';
  { const iy = $('#introYou'); iy.textContent = pname; const sm = document.createElement('small'); sm.textContent = ROBOTS[build.robot].name; iy.appendChild(sm); }
  if (PVP.on) { const fo = $('#introFoe'); fo.textContent = PVP.opp.name; const sm = document.createElement('small'); sm.textContent = ROBOTS[foeBuild.robot].name; fo.appendChild(sm); }
  else $('#introFoe').textContent = ROBOTS[foeBuild.robot].name;
  const el = $('#intro');
  el.hidden = false; el.classList.remove('go', 'fight'); void el.offsetWidth; AU.intro();
  if (!(await wait(2000, tok))) return;
  el.classList.add('fight'); AU.fight(); buzz([60, 30, 90]);
  if (!(await wait(1100, tok))) return;
  el.hidden = true; el.classList.remove('fight');
  void $('#hand').offsetWidth;
  $('#hand').classList.add('deal');
  AU.reveal();
  if (!PVP.on) await runTut(TUT_DUEL, 'duel');
  if (!PVP.on && tok === duelToken && (G.you.mods || []).length) await runTut(TUT_MODDUEL, 'modduel');
  if (tok !== duelToken) return;
  startTurn();
}

function showLog() {
  const l = G && G.log || [];
  $('#logList').innerHTML = l.length ? l.slice().reverse().map(x => '<li><b>T' + x.t + '</b><span>Tú <em>' + x.y + '</em>' + (x.dy ? ' · hiciste ' + x.dy : '') + '</span><span>Rival <em>' + x.f + '</em>' + (x.df ? ' · te hizo ' + x.df : '') + '</span>' + (x.ev ? '<i>⚡ ' + x.ev + '</i>' : '') + '</li>').join('') : '<li>Aún no hay movimientos.</li>';
  $('#logPanel').hidden = false;
}
$('#logBtn').addEventListener('click', showLog);
$('#logClose').addEventListener('click', () => { $('#logPanel').hidden = true; });
$('#hand').addEventListener('click', e => { const c = e.target.closest('.card'); if (c && G) play(G.you.hand[+c.dataset.i]); });
$('#overBtn').addEventListener('click', () => { if (G) play(OVER); });
$('#quitBtn').addEventListener('click', () => { duelToken++; tutEnd(); busy = false; $('#end').hidden = true; pvpLeave(); show('home'); });

// ---- botones generales ----
$('#playBtn').addEventListener('click', startDuel);
$('#buildCard').addEventListener('click', () => { AU.tap(); openGarage(); });
$$('.helpBtn').forEach(b => b.addEventListener('click', () => { AU.tap(); $('#rules').hidden = false; $('#closeRules').focus(); }));
$('#lvlUp').addEventListener('click', () => {
  const L = levelOf(xp); if (L.level >= MAX_LEVEL) return;
  xp += L.need - L.into; saveXp(); applyProgress();
  while (build.cards.length < CFG.handSize) { const nx = CARD_IDS.find(id => cardLevel(id) <= levelOf(xp).level && !build.cards.includes(id)); if (!nx) break; build.cards.push(nx); }
  build.cards.sort(byOrder); saveBuild(); setColor(build.robot);
  $('#lvlUp').textContent = 'Ahora eres nivel ' + levelOf(xp).level;
  setTimeout(() => { $('#lvlUp').textContent = 'Prueba: subir un nivel'; }, 2000);
  if (curView === 'home') renderHome();
});
let resetArmed = false;
$('#lvlReset').addEventListener('click', () => {
  if (!resetArmed) { resetArmed = true; $('#lvlReset').textContent = 'Toca otra vez para confirmar'; setTimeout(() => { resetArmed = false; $('#lvlReset').textContent = 'Prueba: reiniciar progreso'; }, 3000); return; }
  resetArmed = false; xp = 0; saveXp(); applyProgress(); build = defaultBuild(); saveBuild(); setColor(build.robot);
  $('#lvlReset').textContent = 'Progreso reiniciado';
  setTimeout(() => { $('#lvlReset').textContent = 'Prueba: reiniciar progreso'; }, 2000);
  if (curView === 'home') renderHome();
});
let touring = false;
async function tutIdle() { let n = 0; while (n < 3) { await sleep(250); n = $('#tut').hidden ? n + 1 : 0; } }
async function startTour() {
  if (touring || (typeof PVP !== 'undefined' && PVP.code)) return; touring = true;
  try { Object.values(TUT_KEYS).forEach(k => localStorage.removeItem(k)); } catch (e) {}
  AU.init(); $('#rules').hidden = true;
  try {
    show('home'); goPage('home', true); await sleep(500);
    await runTut(TUT_HOME, 'home'); await runTut(TUT_ARENA, 'arena');
    goPage('his', true); await sleep(900); await tutIdle();
    openGarage(); await sleep(500); await tutIdle();
    await startDuel();
  } finally { touring = false; }
}
$('#replayTut2').addEventListener('click', () => { AU.tap(); startTour(); });
$('#replayTut').addEventListener('click', () => { AU.tap(); startTour(); });
function renderTheme() {
  $('#themeRow').innerHTML = ACCENTS.map(a => '<button class="sw' + (a[0] === accent ? ' on' : '') + '" data-acc="' + a[0] + '" aria-label="' + a[1] + '" aria-pressed="' + (a[0] === accent) + '" style="--sw:' + (a[2] || 'conic-gradient(#3fd9d2,#b79cff,#8ee26b,#3fd9d2)') + '"></button>').join('');
  $('#themeName').textContent = ACCENTS.find(a => a[0] === accent)[1] + (armorHex(build.robot) ? ' · ahora manda el color equipado de tu colección; quítalo en Perfil para ver este.' : '');
}
$('#themeBtn').addEventListener('click', () => { AU.tap(); renderTheme(); $('#theme').hidden = false; });
$('#closeTheme').addEventListener('click', () => { $('#theme').hidden = true; });
$('#theme').addEventListener('click', e => { if (e.target.id === 'theme') $('#theme').hidden = true; });
$('#themeRow').addEventListener('click', e => {
  const b = e.target.closest('[data-acc]'); if (!b) return;
  accent = b.dataset.acc; AU.tap();
  try { localStorage.setItem('duelo-accent', accent); } catch (x) {}
  setColor(build.robot); renderTheme(); if (curView === 'home') renderHome();
});
function renderProfile() {
  const t = rec.w + rec.d + rec.l, L = levelOf(xp).level, st = starsOf(xp);
  $('#profName').value = pname; $('#profAv').innerHTML = avatarHTML(56);
  const lv = levelOf(xp), pr = L >= MAX_LEVEL ? starProg(xp) : Math.round(lv.into / lv.need * 100);
  $('#profLv').innerHTML = '<div class="plt"><b>Nivel ' + L + '</b><span>' + (st ? '★ ' + st : (L >= MAX_LEVEL ? 'Máximo' : lv.into + ' / ' + lv.need + ' XP')) + '</span></div><div class="fbar"><i style="width:' + pr + '%"></i></div>';
  $('#profRec').innerHTML = ['easy', 'normal', 'hard'].map(d => { const r = recD[d] || { w: 0, d: 0, l: 0 }; return '<div class="pr ' + d + '"><b>' + DIFFS[d].name + '</b><span><em>' + r.w + '</em> G</span><span><em>' + r.d + '</em> E</span><span><em>' + r.l + '</em> P</span></div>'; }).join('');
  $('#profStats').innerHTML = '<div><b>' + L + '</b>Nivel</div><div><b class="star">' + st + ' ★</b>Estrellas</div><div><b>' + t + '</b>Duelos</div><div><b>' + (t ? Math.round(rec.w / t * 100) : 0) + '%</b>Victorias</div>';
}
const saveName = () => { const v = $('#profName').value.trim().slice(0, 14); if (v) pname = v; try { localStorage.setItem('duelo-name', pname); } catch (e) {} };
$('#profName').addEventListener('change', saveName); $('#profName').addEventListener('blur', saveName);
$('#nearbyBtn').addEventListener('click', pvpOpen);
$('#closeRules').addEventListener('click', () => { $('#rules').hidden = true; });
$('#rules').addEventListener('click', e => { if (e.target.id === 'rules') $('#rules').hidden = true; });
$('#again').addEventListener('click', () => { if (PVP.code) pvpAgain(); else startDuel(); });
$('#endGarage').addEventListener('click', () => { $('#end').hidden = true; openGarage(); });
$('#endHome').addEventListener('click', () => { $('#end').hidden = true; pvpLeave(); show('home'); });
$$('.snd').forEach(b => b.addEventListener('click', () => {
