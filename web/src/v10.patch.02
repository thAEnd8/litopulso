function addXp(gain) {
  const before = levelOf(xp);
  xp += gain; saveXp();
  const after = levelOf(xp);
  if (after.level <= before.level) return '';
  const news = CARD_IDS.filter(id => cardLevel(id) > before.level && cardLevel(id) <= after.level).map(id => CARDS[id].name);
  applyProgress();
  while (build.cards.length < CFG.handSize) { const nx = CARD_IDS.find(id => cardLevel(id) <= after.level && !build.cards.includes(id)); if (!nx) break; build.cards.push(nx); }
  build.cards.sort(byOrder); saveBuild();
  setTimeout(() => AU.ready(), 500);
  return '<b>¡Nivel ' + after.level + '!</b>' + (news.length ? '<div class="lvc">' + news.map(n => '<span>' + n + '</span>').join('') + '</div><small>Carta' + (news.length > 1 ? 's' : '') + ' nueva' + (news.length > 1 ? 's' : '') + '</small>' : '') + '<small>+1 punto de habilidad para el Mercado · ' + (after.level >= MAX_LEVEL ? 'tu núcleo ahora es plateado' : 'tu núcleo se oscurece un tono') + '</small>';
}
