};
function tipFor(n) {
  if (!TIPS[n] || GUIDE.on || INTRO.on) return;
  const pg = n === 'rem' ? 'home' : n;
  setTimeout(() => { if (curPage === pg && curView === 'home' && $('#tut').hidden && !GUIDE.on && !INTRO.on) runTut(TIPS[n], 'tip_' + n); }, 500);
}
