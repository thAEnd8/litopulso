/* v10: ruleta de cristales, ítems, reacciones y mejoras */
.spinrow { display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px; }
.spinrow .btn { margin: 0; min-height: 56px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; line-height: 1.1; }
.spinrow .btn small { font: 600 11px var(--font-body); letter-spacing: 0; text-transform: none; opacity: .75; }
#spinBtn { font-size: 19px; letter-spacing: .16em; }
#spin5Btn { font-size: 14px; letter-spacing: .08em; border-color: #ffd34a88; color: #ffd34a; }
.pity { display: flex; align-items: center; gap: 10px; justify-content: center; margin: -2px 0 10px; font-size: 12px; color: var(--muted); }
.pity span { font: 700 11px var(--font-display); letter-spacing: .12em; text-transform: uppercase; color: #ffd34a; }
.pity .pp { display: flex; gap: 4px; }
.pity .pp i { width: 12px; height: 13px; clip-path: var(--hexclip); background: var(--line); }
.pity .pp i.f { background: #ffd34a; }
.odds { margin-top: 12px; border: 1px solid var(--line); border-radius: var(--cut); background: var(--panel); }
.odds summary { list-style: none; cursor: pointer; padding: 12px 14px; font: 700 13px var(--font-display); letter-spacing: .06em; display: flex; justify-content: space-between; }
.odds summary::-webkit-details-marker { display: none; }
.odds summary::after { content: '+'; color: var(--muted); }
.odds[open] summary::after { content: '−'; }
.odds #colMis { padding: 0 14px 12px; }
.wheelwrap { width: 290px; }
.wheelwrap .cry { filter: drop-shadow(0 0 0 transparent); }
.wheelwrap.spinning .cry { filter: brightness(1.15); }
.wheelwrap.bump svg { animation: wbump .45s cubic-bezier(.2,1.6,.4,1); }
@keyframes wbump { 30% { transform: scale(1.04); } }
.wsparks { position: absolute; left: 50%; top: 4%; width: 0; height: 0; pointer-events: none; z-index: 3; }
.wsparks i { position: absolute; width: 7px; height: 8px; margin: -4px; clip-path: var(--hexclip); background: var(--wg, #ffd34a); box-shadow: 0 0 6px var(--wg, #ffd34a); animation: wsp var(--t, .7s) ease-out forwards; transform: rotate(var(--a)) translateY(0); }
@keyframes wsp { to { transform: rotate(var(--a)) translateY(calc(-1 * var(--d, 80px))); opacity: 0; } }
.prizepop .p5 { display: flex; flex-direction: column; gap: 8px; max-height: 62vh; overflow-y: auto; }
.prizepop .p5 .prize { flex-direction: row; text-align: left; padding: 10px 12px; font-size: 13px; animation: ppPop .4s cubic-bezier(.2,1.4,.4,1) backwards; }
.prizepop .p5 .prize:nth-child(2) { animation-delay: .12s; } .prizepop .p5 .prize:nth-child(3) { animation-delay: .24s; } .prizepop .p5 .prize:nth-child(4) { animation-delay: .36s; } .prizepop .p5 .prize:nth-child(5) { animation-delay: .48s; }
.prizepop .p5 .prize .ptile, .prizepop .p5 .prize .ptile svg, .prizepop .p5 .prize .ptile .sw2, .prizepop .p5 .prize .ptile .fr { width: 40px; height: 40px; }
.prizepop .p5 .prize .big { font-size: 24px; min-width: 48px; }
.r-x { --rc: #ff7a3a; }
.ct.r-x { box-shadow: 0 0 0 1px #ff7a3a inset; }
.remlist { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; text-align: left; }
.remlist li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px 12px 4px 12px; background: var(--panel-2); color: var(--fg); font-size: 13.5px; animation: viewIn .35s var(--d, 0s) ease-out backwards; }
.remlist svg { width: 20px; height: 20px; flex: none; fill: none; stroke: var(--rc, #ffd34a); stroke-width: 1.8; stroke-linejoin: round; }
#remS { width: 100%; }
.remgem.rainbow polygon { stroke: #fff; animation: rbg 2s linear infinite; }
@keyframes rbg { 0% { fill: #ff7a3a55; filter: drop-shadow(0 0 14px #ff7a3a); } 33% { fill: #8ee26b55; filter: drop-shadow(0 0 14px #8ee26b); } 66% { fill: #5a8cff55; filter: drop-shadow(0 0 14px #5a8cff); } 100% { fill: #c08bff55; filter: drop-shadow(0 0 14px #c08bff); } }
.rem.rbw { border-color: #c08bff; }
.rem.rbw svg polygon { animation: rbg 2.4s linear infinite; }
.rest { margin: 0; font-size: 12px; color: var(--muted); }
.rest b { color: var(--fg); }
.gup { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; }
.guph { display: flex; justify-content: space-between; align-items: baseline; }
.guph b { font: 700 14px var(--font-display); }
.guph span { font-size: 12px; color: var(--muted); }
.guph em { font-style: normal; color: var(--fg); font-weight: 700; }
.upr { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px 12px 4px 12px; background: var(--panel); }
.upr div { display: flex; flex-direction: column; min-width: 0; }
.upr b { font: 700 13px var(--font-display); }
.upr small { font-size: 11.5px; color: var(--muted); }
.upr .chipbtn { flex: none; color: #ffd34a; border-color: #ffd34a66; }
.upr .chipbtn:disabled { opacity: .4; }
.ivg { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.iv { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 4px; border: 1px solid var(--line); border-radius: var(--cut); background: var(--panel); text-align: center; }
.iv svg { width: 20px; height: 20px; fill: none; stroke: var(--you); stroke-width: 1.8; stroke-linejoin: round; }
.iv b { font: 700 17px var(--font-display); }
.iv small { font-size: 9.5px; color: var(--muted); letter-spacing: .04em; text-transform: uppercase; line-height: 1.2; }
.rel { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 6px; }
.emi { padding: 6px 10px; border: 1px solid var(--rc, var(--line)); border-radius: 4px 12px 4px 12px; background: var(--panel-2); color: var(--fg); font: 600 12.5px var(--font-display); }
.emi.r-g { --rc: #6c7a8b; } .emi.r-b { --rc: #5a8cff; } .emi.r-r { --rc: #f0475a; }
.emi.lk { opacity: .35; border-style: dashed; }
.icon-btn.emob svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
.emopan { position: fixed; z-index: 35; top: calc(64px + env(safe-area-inset-top, 0px)); right: max(12px, env(safe-area-inset-right, 0px)); max-width: 260px; display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; padding: 10px; border: 1px solid var(--line); border-radius: 4px 16px 4px 16px; background: var(--panel); box-shadow: 0 10px 30px rgba(0,0,0,.5); animation: viewIn .2s ease-out; }
.emopan .emi { cursor: pointer; }
.emoflt { position: fixed; z-index: 36; transform: translate(-50%, 0); padding: 8px 12px; border: 2px solid var(--rc, #6c7a8b); border-radius: 14px; background: #f4f7fb; color: #121821; font: 700 14px var(--font-display); white-space: nowrap; pointer-events: none; animation: emoIn 2.6s ease-out forwards; }
.emoflt.r-g { --rc: #6c7a8b; } .emoflt.r-b { --rc: #5a8cff; } .emoflt.r-r { --rc: #f0475a; }
@keyframes emoIn { 0% { opacity: 0; transform: translate(-50%, 10px) scale(.7); } 10% { opacity: 1; transform: translate(-50%, 0) scale(1.05); } 16% { transform: translate(-50%, 0) scale(1); } 85% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -12px); } }
